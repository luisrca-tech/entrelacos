{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"],
      "env": [
        "PUBLIC_API_URL",
        "PUBLIC_SITE_ID",
        "PUBLIC_ADMIN_ORIGIN",
        "PUBLIC_SITE_INACTIVE",
        "VITE_API_URL"
      ]
    },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true }
  }
}
