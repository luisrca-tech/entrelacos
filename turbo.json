{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"],
      "env": ["PUBLIC_API_URL", "PUBLIC_SITE_ID", "VITE_API_URL"]
    },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true }
  }
}
