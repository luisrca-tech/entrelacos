---
import GiftPreviewPage from "../components/GiftPreviewPage.astro";
import { isLocalGiftPreview } from "../localGiftPreview";
import "../styles/tailwind.css";

const allowed = isLocalGiftPreview(import.meta.env.DEV, Astro.url);
if (!allowed) Astro.response.status = 404;
const publicSiteUrl = import.meta.env.PUBLIC_SITE_URL ?? "https://demo-botanico.entrelacosbr.site/";
---

{allowed ? <GiftPreviewPage /> : (
  <html lang="pt-BR">
    <head>
      <meta charset="UTF-8" />
      <meta name="robots" content="noindex, nofollow" />
      <link rel="canonical" href={new URL("gift-preview/", publicSiteUrl).href} />
      <meta property="og:image" content={new URL("marina-caio-hero.webp", publicSiteUrl).href} />
      <meta name="twitter:image" content={new URL("marina-caio-hero.webp", publicSiteUrl).href} />
      <title>Indisponível</title>
    </head>
    <body><p>Prévia indisponível.</p></body>
  </html>
)}
