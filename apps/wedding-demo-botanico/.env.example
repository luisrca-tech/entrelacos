# Build-time application environment. Use development only for development deployments.
APP_ENV=development
# Public build-time configuration. Register the exact site origin through the owner API.
PUBLIC_API_URL=http://localhost:8080
PUBLIC_ADMIN_ORIGIN=http://localhost:3000
PUBLIC_LANDING_URL=http://localhost:4323/
PUBLIC_SITE_ID=demo-wedding
# Production-only client opt-in. The API must independently authorize this same live showcase.
PUBLIC_LIVE_DEMO_SITE_ID=
# Pagar.me public key (pk_test_… locally and in dev, pk_… in production). It only
# tokenizes cards in the browser; register the site domain in the Pagar.me panel.
PUBLIC_PAGARME_PUBLIC_KEY=
# Set true and rebuild to publish the neutral static page on every served hostname.
PUBLIC_SITE_INACTIVE=false
