# Runtime settings; private database settings are loaded from packages/database/.env.
PORT=8080
# Use test only for the verified disposable testing database.
APP_ENV=development
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
ADMIN_ORIGIN=http://localhost:3000
# SMS remains deferred to Block 3.
SMS_MODE=simulated
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_TEST_PHONE_ALLOWLIST=
