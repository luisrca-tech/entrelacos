# Runtime settings; private database settings are loaded from packages/database/.env.
PORT=8080
# Railway production derives this from RAILWAY_ENVIRONMENT_NAME. Set it explicitly elsewhere.
APP_ENV=development
BETTER_AUTH_SECRET=
# Railway derives this from RAILWAY_PUBLIC_DOMAIN when omitted.
BETTER_AUTH_URL=http://localhost:8080
ADMIN_ORIGIN=http://localhost:3000
# Manual group PIN is the MVP default; use simulated only for explicit demos and real only after Twilio gates pass.
SMS_MODE=manual
# Set true only for local development/test fixtures that need to display MOCK codes.
EXPOSE_SIMULATION_CODE=false
GUEST_FINGERPRINT_SECRET=
GUEST_DEMO_GRANT_SECRET=
# Demo grants fail closed when this allowlist is empty. Use comma-separated E.164 mobiles.
DEMO_PHONE_ALLOWLIST=
# Railway enables its trusted proxy headers automatically. Set this explicitly elsewhere.
TRUST_PROXY_HEADERS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_TEST_PHONE_ALLOWLIST=
SMS_REAL_AUTHORIZED=false
TWILIO_BRAZIL_CONFIRMED=false
TWILIO_TRIAL_USAGE_CONFIRMED=false
