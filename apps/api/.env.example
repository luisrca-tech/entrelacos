# Runtime settings; private database settings are loaded from packages/database/.env.
PORT=8080
# Railway production derives this from RAILWAY_ENVIRONMENT_NAME. Set it explicitly elsewhere.
APP_ENV=development
BETTER_AUTH_SECRET=
# Railway derives this from RAILWAY_PUBLIC_DOMAIN when omitted.
BETTER_AUTH_URL=http://localhost:8080
ADMIN_ORIGIN=http://localhost:3000
# Guests confirm the invitation with the registered phone and the manually shared group PIN.
GUEST_FINGERPRINT_SECRET=
# Railway enables its trusted proxy headers automatically. Set this explicitly elsewhere.
TRUST_PROXY_HEADERS=false

# Gift payments (Pagar.me) remain disabled until every setting below is supplied.
# test uses an sk_test_ key outside production; live (sk_ key, never sk_test_) is restricted to production.
PAGARME_MODE=disabled
# Enable background processing for an explicit development or test run.
PAGARME_BACKGROUND_PROCESSING=false
# Optional comma-separated showcase site IDs, admitted only with live mode in production.
# PAGARME_LIVE_DEMO_SITE_ID=demo-wedding
# Secret key from the Pagar.me dashboard (Development > Keys). Never commit a real value.
PAGARME_SECRET_KEY=
# Platform recipient (rp_...) that receives the commission and bears processing fees.
PAGARME_PLATFORM_RECIPIENT_ID=
# Basic auth credentials configured on the Pagar.me webhook for /v1/webhooks/pagarme.
# The user must not contain ":"; the password needs 32-255 printable characters.
PAGARME_WEBHOOK_BASIC_USER=
PAGARME_WEBHOOK_BASIC_PASSWORD=
# Server-selected wedding origin, also registered for the site. Development defaults to this local origin.
GIFT_PUBLIC_ORIGIN=http://localhost:4321
# Enable sandbox history alongside the provider when exercising the local payment flow.
GIFT_PAYMENT_HISTORY_MODE=disabled

# Gift images remain disabled by default. Supply the existing environment bucket and image delivery origin.
# HTTPS *.r2.dev delivery is allowed only in development/test.
# Production uses an approved HTTPS delivery origin, including the API media route.
GIFT_MEDIA_MODE=disabled
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_ORIGIN=
