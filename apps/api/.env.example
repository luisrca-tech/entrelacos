# Runtime settings; private database settings are loaded from packages/database/.env.
PORT=8080
# Railway production derives this from RAILWAY_ENVIRONMENT_NAME. Set it explicitly elsewhere.
APP_ENV=development
BETTER_AUTH_SECRET=
# Railway derives this from RAILWAY_PUBLIC_DOMAIN when omitted.
BETTER_AUTH_URL=http://localhost:8080
ADMIN_ORIGIN=http://localhost:3000
# Guests confirm the invitation with the registered phone and the manually shared group PIN.
GUEST_FINGERPRINT_SECRET=
# Railway enables its trusted proxy headers automatically. Set this explicitly elsewhere.
TRUST_PROXY_HEADERS=false

# Gift payments remain disabled until all selected provider settings are supplied.
# Use sandbox in development/test; live is restricted to production.
ASAAS_MODE=disabled
ASAAS_API_KEY=
ASAAS_PLATFORM_ACCOUNT_ID=
ASAAS_PLATFORM_WALLET_ID=
ASAAS_CREDENTIAL_KEY_ID=
# Standard padded base64 encoding of exactly 32 random bytes. Keep stable to decrypt stored credentials.
ASAAS_CREDENTIAL_KEY=
# Public HTTPS tunnel origin for the local API, without a path. Callback: /v1/webhooks/asaas.
# This is separate from BETTER_AUTH_URL, ADMIN_ORIGIN, and the local wedding site's origin.
ASAAS_WEBHOOK_PUBLIC_ORIGIN=
# Alert destination for the one-time development webhook registration operation.
ASAAS_WEBHOOK_NOTIFICATION_EMAIL=
# Server-selected wedding origin, also registered for the site. Development defaults to this local origin.
GIFT_PUBLIC_ORIGIN=http://localhost:4321
# Enable sandbox history alongside the provider when exercising the local payment flow.
GIFT_PAYMENT_HISTORY_MODE=disabled

# Gift images remain disabled by default. Supply the existing environment bucket and image delivery origin.
# HTTPS *.r2.dev delivery is allowed only in development/test; production requires a custom domain.
GIFT_MEDIA_MODE=disabled
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_ORIGIN=
