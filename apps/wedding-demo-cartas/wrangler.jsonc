{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demo-cartas",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist"
  },
  "env": {
    "dev": {
      "name": "demo-cartas-dev",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "demo-cartas-dev.entrelacosbr.site",
          "custom_domain": true
        }
      ]
    }
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "demo-cartas.entrelacosbr.site",
      "custom_domain": true
    }
  ]
}
