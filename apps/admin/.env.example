# Browser-safe values use the VITE_ prefix and may be included in client assets.
# Reserved for the future authenticated API integration; the scaffold does not consume it.
VITE_API_URL=http://localhost:8080

# Server-only values stay unprefixed. Keep real values out of this file.
# Reserved for the future server-side API integration; the scaffold does not consume it.
API_BASE_URL=http://localhost:8080
