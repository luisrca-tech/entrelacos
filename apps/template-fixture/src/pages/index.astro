---
import { GiftSection, WeddingHome } from "@entrelacos/template-root/v1";
import LocalSection from "../components/LocalSection.astro";
import "../styles/tailwind.css";
import { hero, homeSeo, navigation, site, welcome } from "../data/site";
---

<WeddingHome
  locale="pt-BR"
  site={site}
  seo={homeSeo}
  navigation={navigation}
  footer={{
    names: "Casa Aurora",
    dateLabel: "12 de abril de 2028",
    links: [{ label: "Hospedagem", href: "/hospedagem" }],
    rsvp: { label: "Falar com a organização", href: "/hospedagem" },
    year: "2028",
    copyright: "© Casa Aurora",
    attribution: "By EntreLaços",
  }}
  hero={hero}
  story={welcome}
  sectionOrder={["story", "hero"]}
>
  <Fragment slot="after-main">
    <LocalSection id="hospedagem" title="Chegar também faz parte da experiência.">
      <p>Uma seção exclusiva do host pode viver no ponto de extensão nomeado.</p>
    </LocalSection>
    <GiftSection content={{id:"fixture-gifts",title:"Presentes na nossa celebração."}}>
      <p>Os presentes simbólicos podem fazer parte da celebração.</p>
    </GiftSection>
  </Fragment>
</WeddingHome>
