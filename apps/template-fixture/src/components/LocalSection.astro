---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="bg-[#d9a37f] px-[max(1rem,calc((100vw-78rem)/2))] py-20 text-[#2a211d]">
  <p class="m-0 mb-4 text-[0.75rem] uppercase tracking-[0.16em]">Extensão local</p>
  <h2 class="m-0 max-w-[14ch] font-template-serif text-[clamp(2.5rem,6vw,5rem)] font-normal tracking-[-0.06em] leading-[0.96]">{title}</h2>
  <slot />
</section>
