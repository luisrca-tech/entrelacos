---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="fixture-local-section">
  <p>Extensão local</p>
  <h2>{title}</h2>
  <slot />
</section>

<style>
  .fixture-local-section {
    padding: 5rem max(1rem, calc((100vw - 78rem) / 2));
    background: #d9a37f;
    color: #2a211d;
  }

  .fixture-local-section p {
    margin: 0 0 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .fixture-local-section h2 {
    max-width: 14ch;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.96;
  }
</style>
