---
import WeddingLayout from "@entrelacos/template-root/layout";
import TemplateSection from "@entrelacos/template-root/section";
import { AdminRecognition, FeatureAvailability, GuestAccess } from "@entrelacos/wedding-features";
import "../styles/tailwind.css";

const inactive = import.meta.env.PUBLIC_SITE_INACTIVE === "true";
const access = { siteId: import.meta.env.PUBLIC_SITE_ID, apiOrigin: import.meta.env.PUBLIC_API_URL, panelOrigin: import.meta.env.PUBLIC_ADMIN_ORIGIN };
const navigation = [
  { label: "História", href: "#story" },
  { label: "Detalhes", href: "#details" },
  { label: "Confirmar presença", href: "#guest-access" },
  { label: "Recursos", href: "#capabilities" },
];
const guestAccess = { siteId: import.meta.env.PUBLIC_SITE_ID ?? "", apiOrigin: import.meta.env.PUBLIC_API_URL ?? "" };
---

<WeddingLayout
  title="EntreLaços | modelo público de casamento"
  description="Um modelo mínimo de site público de casamento para EntreLaços."
  brand="EntreLaços"
  eventDate={inactive ? undefined : "18 de setembro de 2027"}
  navigation={inactive ? [] : navigation}
>
  <Fragment slot="admin-access">{access.siteId && access.apiOrigin && access.panelOrigin && <AdminRecognition {...access} client:load />}</Fragment>
  {inactive ? <section style="padding: 6rem 2rem; text-align: center; min-height: 70vh; background: #34483d; color: #f4f0e8;"><h1>Site indisponível</h1><p>Este site de casamento está temporariamente indisponível.</p></section> : (<>
  <section class="demo-hero" aria-labelledby="demo-title">
    <div class="demo-hero__placeholder" aria-hidden="true"></div>
    <div class="demo-hero__content">
      <p class="demo-eyebrow">Modelo público</p>
      <h1 id="demo-title">Marina <span>&amp;</span> Caio</h1>
      <p class="demo-hero__lede">
        Um ponto de partida sereno para um site de casamento. Conteúdo, mídia,
        confirmação de presença e fluxos de operação se encontram no mesmo
        espaço, com acesso protegido para cada família.
      </p>
      <p class="demo-hero__meta">18 de setembro de 2027 · Goiânia, GO</p>
    </div>
  </section>

  <TemplateSection
    id="story"
    eyebrow="01 / História"
    title="Um layout reutilizável com espaço para a história do casal."
    description="O modelo define o ritmo da página e uma estrutura acessível. Cada app de casamento fornecerá seu próprio conteúdo e mídia depois."
  >
    <p>
      Esta seção de exemplo mostra que a estrutura pública pode ser composta
      com conteúdo editorial e confirmação de presença sem expor dados dos
      convidados.
    </p>
  </TemplateSection>

  <TemplateSection
    id="details"
    eyebrow="02 / Detalhes"
    title="Informações práticas continuam fáceis de encontrar."
    description="O primeiro modelo dará destaque à programação, ao local e aos pontos de entrada para confirmação de presença em telas pequenas."
    tone="olive"
  >
    <div class="demo-detail-grid">
      <article>
        <p class="demo-detail-grid__label">Cerimônia</p>
        <p>17:00 · Casablanca Eventos</p>
      </article>
      <article>
        <p class="demo-detail-grid__label">Recepção</p>
        <p>19:00 · Mesmo local</p>
      </article>
      <article>
        <p class="demo-detail-grid__label">Local</p>
        <p>Jardim Atlântico, Goiânia</p>
      </article>
    </div>
  </TemplateSection>

  <section id="guest-access" class="demo-guest-access" aria-labelledby="guest-access-section-title">
    <div class="demo-guest-access__heading">
      <p class="demo-eyebrow">03 / Confirmação</p>
      <h2 id="guest-access-section-title">Seu convite, no seu tempo.</h2>
      <p>
        Encontre sua família pelo nome e celular brasileiro. Depois da
        confirmação, os nomes do convite ficam disponíveis somente nesta aba.
      </p>
    </div>
    <GuestAccess {...guestAccess} demoMode client:load />
  </section>

  <section id="capabilities" class="demo-capabilities" aria-labelledby="capabilities-title">
    <div>
      <p class="demo-eyebrow">04 / Mapa de recursos</p>
      <h2 id="capabilities-title">O que este modelo demonstra</h2>
      <p>
        As fronteiras de apresentação compartilhadas estão prontas para os
        próximos agentes. O comportamento planejado do produto continua
        claramente identificado como planejado.
      </p>
    </div>
    <FeatureAvailability client:visible />
  </section>
</>)}
</WeddingLayout>

<style>
  :global(:root) {
    --demo-ink: #25352b;
    --demo-muted: #637066;
    --demo-paper: #f4f0e8;
    --demo-line: rgba(37, 53, 43, 0.18);
  }

  .demo-hero {
    position: relative;
    display: grid;
    min-height: min(78vh, 760px);
    overflow: hidden;
    background: var(--demo-ink);
    color: var(--demo-paper);
  }

  .demo-hero__placeholder {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 75% 20%, rgba(215, 190, 150, 0.34), transparent 28%),
      linear-gradient(135deg, #687d68 0%, #34483d 52%, #18261f 100%);
    opacity: 0.92;
  }

  .demo-hero__placeholder::after {
    position: absolute;
    inset: 12% 10%;
    border: 1px solid rgba(244, 240, 232, 0.42);
    content: "";
  }

  .demo-hero__content {
    position: relative;
    align-self: end;
    width: min(100% - 3rem, 78rem);
    margin: 0 auto;
    padding: clamp(8rem, 22vh, 15rem) 0 4rem;
  }

  .demo-eyebrow,
  .demo-detail-grid__label {
    margin: 0 0 1rem;
    color: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .demo-hero h1 {
    max-width: 10ch;
    margin: 0;
    font-size: clamp(4rem, 12vw, 10rem);
    font-weight: 400;
    letter-spacing: -0.08em;
    line-height: 0.88;
  }

  .demo-hero h1 span {
    font-style: italic;
    font-weight: 300;
  }

  .demo-hero__lede {
    max-width: 34rem;
    margin: 2rem 0 0;
    color: rgba(244, 240, 232, 0.78);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .demo-hero__meta {
    margin: 2rem 0 0;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .demo-detail-grid {
    display: grid;
    gap: 1px;
    margin-top: 2rem;
    background: var(--demo-line);
  }

  .demo-detail-grid article {
    padding: 1.5rem;
    background: var(--demo-ink);
  }

  .demo-detail-grid__label {
    margin-bottom: 0.5rem;
    color: rgba(244, 240, 232, 0.64);
  }

  .demo-detail-grid p:last-child {
    margin: 0;
    font-size: 1.1rem;
  }

  .demo-capabilities {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 8vw, 8rem);
    width: min(100% - 3rem, 78rem);
    margin: 0 auto;
    padding: clamp(5rem, 12vw, 10rem) 0;
  }

  .demo-guest-access {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 8vw, 8rem);
    padding: clamp(5rem, 12vw, 10rem) max(1rem, calc((100vw - 78rem) / 2));
    background: var(--demo-paper);
  }

  .demo-guest-access__heading {
    align-self: start;
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .demo-guest-access h2 {
    max-width: 10ch;
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.96;
  }

  .demo-guest-access__heading > p:last-child {
    max-width: 28rem;
    margin-top: 1.5rem;
    color: var(--demo-muted);
    line-height: 1.6;
  }

  .demo-capabilities h2 {
    max-width: 10ch;
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.96;
  }

  .demo-capabilities > div > p:last-child {
    max-width: 28rem;
    margin-top: 1.5rem;
    color: var(--demo-muted);
    line-height: 1.6;
  }

  @media (max-width: 720px) {
    .demo-hero__content,
    .demo-capabilities {
      width: min(100% - 2rem, 78rem);
    }

    .demo-capabilities,
    .demo-guest-access {
      display: block;
    }

    .demo-capabilities > div,
    .demo-guest-access__heading {
      margin-bottom: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-hero__placeholder {
      background: #34483d;
    }
  }
</style>
