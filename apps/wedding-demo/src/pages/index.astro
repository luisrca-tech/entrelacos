---
import { WeddingHome, WeddingLayout } from "@entrelacos/template-root/v1";
import { AdminRecognition, GuestAccess, MessageMural } from "@entrelacos/wedding-features";
import "../styles/tailwind.css";

const inactive = import.meta.env.PUBLIC_SITE_INACTIVE === "true";
const access = {
  siteId: import.meta.env.PUBLIC_SITE_ID,
  apiOrigin: import.meta.env.PUBLIC_API_URL,
  panelOrigin: import.meta.env.PUBLIC_ADMIN_ORIGIN,
};
const site = { name: "Marina & Caio", href: "/" };
const seo = {
  title: "Marina & Caio | 18 de setembro de 2027",
  description: "Informações sobre a celebração de Marina & Caio em Goiânia.",
  canonical: "https://demo.entrelacos.workers.dev/",
  robots: "noindex, nofollow" as const,
  socialImage: {
    url: "https://demo.entrelacos.workers.dev/marina-caio-hero.webp",
    alt: "Marina e Caio se beijam sob uma árvore ao pôr do sol",
  },
};
const navigation = {
  ariaLabel: "Navegação principal",
  menuLabel: "Abrir menu",
  extensionAnchorIds: ["guest-access", "mural"],
  links: [
    { label: "Galeria", href: "#gallery" },
    { label: "História", href: "#story" },
    { label: "Programação", href: "#schedule" },
    { label: "Local", href: "#venue" },
    { label: "Confirmar presença", href: "#guest-access" },
    { label: "Mural", href: "#mural" },
  ],
};
const footer = {
  names: "Marina & Caio",
  dateLabel: "18 de setembro de 2027",
  links: [
    { label: "Galeria", href: "#gallery" },
    { label: "História", href: "#story" },
    { label: "Programação", href: "#schedule" },
    { label: "Local", href: "#venue" },
  ],
  rsvp: { label: "Confirmar presença", href: "#guest-access" },
  year: "2027",
  copyright: "© Marina & Caio",
  attribution: "By EntreLaços",
};
const hero = {
  id: "hero",
  eyebrow: "Nosso casamento",
  title: "Marina & Caio",
  description: "Um dia para celebrar o encontro, a família e tudo o que nos trouxe até aqui.",
  dateLabel: "18 de setembro de 2027",
  locationLabel: "Goiânia, GO",
  media: {
    kind: "video" as const,
    src: "/marina-caio-hero.mp4",
    poster: "/marina-caio-hero-poster.webp",
    alt: "Marina e Caio caminham de mãos dadas por um campo ao pôr do sol",
    width: 1920,
    height: 1080,
  },
  action: { label: "Confirmar presença", href: "#guest-access" },
  intro: {
    brandLabel: "Marina & Caio",
    topLabel: "Marina &",
    bottomLabel: "Caio",
  },
};
const story = {
  id: "story",
  eyebrow: "A nossa história",
  title: "O que o tempo uniu, a festa consagra.",
  description: "Uma história feita de escolhas, agora pronta para ser celebrada.",
  body: "Não foi um único instante que os fez casal. Foi o acumular de escolhas: ficar, cuidar, construir um nós. Os dias simples, as decisões a dois, a casa que se fez no outro. O que começou em silêncio agora se faz festa, e vocês estão aqui para testemunhar o voto que o tempo já ensaiou.",
  media: {
    kind: "image" as const,
    src: "/marina-caio-story-encounter.webp",
    alt: "Marina e Caio caminham sorrindo por um caminho arborizado",
    width: 1448,
    height: 1086,
  },
  sequence: [
    {
      kind: "image" as const,
      src: "/marina-caio-story-home.webp",
      alt: "Marina e Caio conversam sentados com xícaras de café ao ar livre",
      width: 1448,
      height: 1086,
    },
    {
      kind: "image" as const,
      src: "/marina-caio-story-celebration.webp",
      alt: "Marina e Caio se abraçam ao pôr do sol",
      width: 1448,
      height: 1086,
    },
  ],
};
const gallery = {
  id: "gallery",
  eyebrow: "Fragmentos",
  title: "Antes do sim, um dia só nosso.",
  description: "O pré-wedding é o ensaio do eterno: o casal sozinho, a luz, o silêncio entre um olhar e outro. Aqui, cada sequência guarda esse momento inteiro.",
  controls: {
    ariaLabel: "Navegação da galeria",
    previousLabel: "Anterior",
    nextLabel: "Próxima",
    expandLabel: "Expandir galeria",
    closeLabel: "Fechar galeria",
  },
  items: [
    {
      id: "gallery-encontro",
      caption: "O começo do ensaio",
      media: {
        kind: "image" as const,
        src: "/marina-caio-gallery-one.webp",
        alt: "Marina e Caio caminham de mãos dadas por um campo iluminado",
        width: 1448,
        height: 1086,
      },
    },
    {
      id: "gallery-caminho",
      caption: "Entre caminhos",
      media: {
        kind: "image" as const,
        src: "/marina-caio-gallery-two.webp",
        alt: "Marina e Caio caminham de costas por um caminho entre árvores",
        width: 1448,
        height: 1086,
      },
    },
    {
      id: "gallery-celebracao",
      caption: "Um instante antes do sim",
      media: {
        kind: "image" as const,
        src: "/marina-caio-gallery-three.webp",
        alt: "Marina e Caio trocam olhares em um retrato próximo",
        width: 1448,
        height: 1086,
      },
    },
    {
      id: "gallery-retrato",
      caption: "Um retrato sem pressa",
      media: {
        kind: "image" as const,
        src: "/marina-caio-gallery-four.webp",
        alt: "Marina e Caio posam juntos em um jardim ao entardecer",
        width: 1448,
        height: 1086,
      },
    },
    {
      id: "gallery-luz",
      caption: "A luz do fim da tarde",
      media: {
        kind: "image" as const,
        src: "/marina-caio-gallery-five.webp",
        alt: "Marina dança de mãos dadas com Caio em um campo ao pôr do sol",
        width: 1448,
        height: 1086,
      },
    },
    {
      id: "gallery-abraco",
      caption: "O abraço que fica",
      media: {
        kind: "image" as const,
        src: "/marina-caio-gallery-six.webp",
        alt: "Marina e Caio se abraçam à beira de um lago",
        width: 1448,
        height: 1086,
      },
    },
  ],
};
const schedule = {
  id: "schedule",
  eyebrow: "O dia",
  title: "Uma programação para viver sem pressa.",
  description: "Qualquer dúvida sobre horários, chegada ou traje, fale com quem enviou o seu convite.",
  guidanceLabel: "Orientações práticas",
  entries: [
    {
      id: "ceremony",
      time: "17:00",
      title: "Cerimônia",
      body: "A celebração começa no mesmo local da recepção.",
      location: "Casablanca Eventos",
    },
    {
      id: "reception",
      time: "19:00",
      title: "Recepção",
      body: "Jantar, brindes e pista para continuar a noite juntos.",
      location: "Casablanca Eventos",
    },
  ],
  guidance: [
    { id: "arrival", title: "Chegada", body: "Reserve alguns minutos para estacionar e encontrar seu lugar com calma." },
    { id: "attire", title: "Traje", body: "Traje social. Vista-se à altura da celebração: o dia pede elegância, presença e respeito ao momento." },
  ],
};
const venue = {
  id: "venue",
  eyebrow: "O local",
  title: "Nos encontramos em Goiânia.",
  name: "Casablanca Eventos",
  address: "Av Ipanema 747, Jardim Atlântico, Goiânia, GO, 74343-010",
  mapEmbedUrl: "https://maps.google.com/maps?q=Casablanca%20Eventos%2C%20Av%20Ipanema%20747%2C%20Jardim%20Atl%C3%A2ntico%2C%20Goi%C3%A2nia%2C%20GO%2074343-010&output=embed",
  directions: {
    label: "Como chegar",
    href: "https://www.google.com/maps/dir/?api=1&destination=Casablanca%20Eventos%2C%20Av%20Ipanema%20747%2C%20Jardim%20Atl%C3%A2ntico%2C%20Goi%C3%A2nia%2C%20GO%2074343-010",
  },
  fallback: {
    label: "Abrir endereço",
    href: "https://casablancaeventosgoiania.com.br/contato",
  },
  labels: {
    mapTitle: "Mapa do Casablanca Eventos",
    addressLabel: "Endereço completo",
    copyLabel: "Copiar endereço",
    copiedLabel: "Endereço copiado",
    copyErrorLabel: "Não foi possível copiar o endereço",
  },
};
const guestAccess = {
  siteId: import.meta.env.PUBLIC_SITE_ID ?? "",
  apiOrigin: import.meta.env.PUBLIC_API_URL ?? "",
};
---

{inactive ? (
  <WeddingLayout locale="pt-BR" site={site} seo={seo}>
    <section class="demo-inactive" aria-labelledby="demo-inactive-title">
      <h1 id="demo-inactive-title">Site indisponível</h1>
      <p>Este site de casamento está temporariamente indisponível.</p>
    </section>
  </WeddingLayout>
) : (
  <WeddingHome
    locale="pt-BR"
    site={site}
    seo={seo}
    navigation={navigation}
    footer={footer}
    hero={hero}
    story={story}
    gallery={gallery}
    schedule={schedule}
    venue={venue}
  >
    <Fragment slot="head"><link rel="icon" href="/marina-caio-monogram.svg" type="image/svg+xml" /></Fragment>
    <Fragment slot="header-addon"><span class="demo-monogram" aria-label="Monograma M e C">M&amp;C</span></Fragment>
    <Fragment slot="admin-access">{access.siteId && access.apiOrigin && access.panelOrigin && <AdminRecognition {...access} client:load />}</Fragment>
    <Fragment slot="after-main">
      <section id="guest-access" class="demo-guest-access" aria-labelledby="guest-access-section-title">
        <div class="demo-guest-access__heading">
          <p class="demo-eyebrow">Confirmação</p>
          <h2 id="guest-access-section-title">Seu convite, no seu tempo.</h2>
          <p>Encontre sua família pelo nome e pelo PIN do convite. Depois da confirmação, os nomes ficam disponíveis somente nesta aba.</p>
        </div>
        <GuestAccess {...guestAccess} client:only="react">
          <p slot="fallback" class="demo-client-fallback">Esta área interativa precisa de JavaScript. Ative-o para encontrar seu convite e responder à confirmação.</p>
        </GuestAccess>
      </section>
      <div id="mural" class="demo-mural">
        <MessageMural {...guestAccess} client:only="react">
          <p slot="fallback" class="demo-client-fallback">Esta área interativa precisa de JavaScript. Ative-o para consultar o mural.</p>
        </MessageMural>
      </div>
    </Fragment>
  </WeddingHome>
)}

<style>
  :global(:root) {
    --demo-ink: #25352b;
    --demo-muted: #637066;
    --demo-paper: #f4f0e8;
    --demo-line: rgba(37, 53, 43, 0.18);
    --demo-page-inset: max(
      clamp(1rem, 2.7778vw, 2.5rem),
      calc((100vw - 120rem) / 2 + 2.5rem)
    );
  }

  .demo-inactive {
    display: grid;
    min-height: 70vh;
    place-content: center;
    padding: 6rem 2rem;
    background: #34483d;
    color: #f4f0e8;
    text-align: center;
  }

  .demo-inactive h1 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.5rem, 7vw, 6rem);
    font-weight: 400;
  }

  .demo-inactive p {
    margin: 1rem 0 0;
  }

  .demo-monogram {
    display: inline-flex;
    min-width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, currentColor 56%, transparent);
    border-radius: 50%;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.72rem;
    letter-spacing: 0;
    text-transform: none;
  }

  @media (max-width: 1024px) {
    .demo-monogram {
      display: none;
    }
  }

  .demo-guest-access {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 8vw, 8rem);
    padding: clamp(2rem, 3vw, 3rem) var(--demo-page-inset)
      clamp(1.5rem, 3vw, 2.5rem);
    background: var(--demo-paper);
  }

  .demo-guest-access__heading {
    align-self: start;
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .demo-eyebrow {
    margin: 0 0 1rem;
    color: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .demo-guest-access h2 {
    max-width: 10ch;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.96;
  }

  .demo-guest-access__heading > p:last-child {
    max-width: 28rem;
    margin-top: 1.5rem;
    color: var(--demo-muted);
    line-height: 1.6;
  }

  .demo-mural {
    padding: clamp(1rem, 2vw, 2rem) var(--demo-page-inset)
      clamp(4rem, 8vw, 6rem);
    background: var(--demo-paper);
  }

  .demo-client-fallback {
    max-width: 38rem;
    margin: 0;
    padding: 1.25rem;
    border: 1px solid var(--demo-line);
    color: var(--demo-muted);
    line-height: 1.6;
  }

  @media (max-width: 720px) {
    .demo-guest-access {
      display: block;
    }

    .demo-guest-access__heading {
      margin-bottom: 3rem;
    }
  }
</style>
