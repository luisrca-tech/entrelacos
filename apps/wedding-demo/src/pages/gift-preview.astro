---
import GiftPreviewPage from "../components/GiftPreviewPage.astro";
import { isLocalGiftPreview } from "../localGiftPreview";
import "../styles/tailwind.css";

const allowed = isLocalGiftPreview(import.meta.env.DEV, Astro.url);
if (!allowed) Astro.response.status = 404;
---

{allowed ? <GiftPreviewPage /> : (
  <html lang="pt-BR">
    <head>
      <meta charset="UTF-8" />
      <meta name="robots" content="noindex, nofollow" />
      <link rel="canonical" href="https://demo.entrelacos.workers.dev/gift-preview/" />
      <meta property="og:image" content="https://demo.entrelacos.workers.dev/marina-caio-hero.webp" />
      <meta name="twitter:image" content="https://demo.entrelacos.workers.dev/marina-caio-hero.webp" />
      <title>Indisponível</title>
    </head>
    <body><p>Prévia indisponível.</p></body>
  </html>
)}
