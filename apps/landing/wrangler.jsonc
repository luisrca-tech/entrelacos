{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "entrelacos",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist"
  },
  "env": {
    "dev": {
      "name": "entrelacos-dev",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "dev.entrelacosbr.site",
          "custom_domain": true
        }
      ]
    }
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "entrelacosbr.site",
      "custom_domain": true
    }
  ]
}
