---
import PublicHeader from "../components/PublicHeader.astro";
import PaymentSeal from "../components/PaymentSeal.astro";
import PublicFooter from "../components/PublicFooter.astro";
import LandingTracking from "../components/LandingTracking.astro";
import "../styles/landing.css";
import "../styles/cinematic.css";
import "lenis/dist/lenis.css";
import { landingConfig } from "../landingConfig";
import { GIFT_PLATFORM_TARIFFS } from "../../../../packages/contracts/src/giftTariffs";
import { faqPricingExampleNominalCents, faqPricingExamples, formatBrl } from "../faqPricingExample";
import { exclusiveDeliveryLabel, formatPlanPrice, SITE_PLANS, siteDeliveryLabel, siteOnlineLabel } from "../landingOffer";
const config = landingConfig(import.meta.env, import.meta.env.PROD);
const contactLabel = new URL(config.contactUrl).hostname === "wa.me"
  ? "Falar no WhatsApp"
  : "Solicitar proposta";
const modelPrice = formatPlanPrice(SITE_PLANS.model.priceCents);
const exclusivePrice = formatPlanPrice(SITE_PLANS.exclusive.fromCents);
const exampleGift = formatBrl(faqPricingExampleNominalCents);
const examplePix = formatBrl(faqPricingExamples[0].totalCents);
const withdrawalFee = formatBrl(GIFT_PLATFORM_TARIFFS.withdrawalFeeCents);
const steps = [
  ["Conversa", "Vocês nos chamam no WhatsApp, contam a data e o estilo que imaginam, e fechamos o plano."],
  ["Material", "Vocês enviam fotos, vídeos, textos e as informações do evento. Se ainda não tiverem tudo, pensamos juntos. O prazo começa a contar quando recebemos todo o material."],
  ["Montagem e aprovação", `Em ${siteDeliveryLabel}, montamos o site, ajustamos os detalhes com vocês e entregamos a versão aprovada.`],
  ["Publicação e suporte", `Publicamos o site, entregamos o painel e seguimos disponíveis para suporte. O site fica no ar ${siteOnlineLabel}.`],
];
const questions = [
  ["Podemos personalizar o site?", "Sim. Alinhamos cores, tipografia, fotos e textos à identidade visual de vocês. Também podemos adaptar a estrutura de algumas seções, conforme o que for combinado. O Entrelaços cuida da montagem e da publicação."],
  ["O que podemos gerenciar pelo painel?", "Vocês podem cadastrar famílias e convidados, acompanhar confirmações, moderar o mural e gerenciar a lista de presentes. Os recebimentos ficam disponíveis conforme a configuração da conta do casamento."],
  ["Como funcionam os presentes em dinheiro?", `Os itens da lista representam contribuições para o casal, sem entrega de produtos físicos. O convidado escolhe o presente e paga por Pix ou cartão de crédito, em até ${GIFT_PLATFORM_TARIFFS.maxInstallments}x conforme o valor do presente, com o total e o valor de cada parcela antes de confirmar. A Pagar.me processa o pagamento.`],
  ["Os convidados precisam criar uma conta?", "Não. Para confirmar presença, a família usa o telefone de contato cadastrado e o PIN recebido com o convite. As informações do evento ficam disponíveis no site."],
  ["Podemos usar no celular?", "Sim. Os sites e o painel têm versões que se adaptam ao celular. O convidado pode consultar as informações, confirmar presença e deixar sua mensagem pelo próprio aparelho."],
  ["Como vocês usam os nossos dados?", "Só para o site e o painel funcionarem. O CPF, o endereço e os dados bancários do titular servem para criar a conta de recebimentos na Pagar.me e enviar os saques para a conta que vocês escolherem. Não vendemos dados. Os detalhes estão na política de privacidade, no rodapé."],
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Arm the short rings introduction before first paint. It only animates
      // the decorative hero art; the page is never locked or covered.
      try {
        const navigation = performance.getEntriesByType?.("navigation")[0];
        let seen = false;
        try { seen = sessionStorage.getItem("entrelacos-opening") === "seen"; } catch {}
        const internalVisit = document.referrer && new URL(document.referrer).origin === location.origin;
        const returning = navigation?.type !== "reload" && (seen || internalVisit);
        if (!returning && !location.hash && navigation?.type !== "back_forward" &&
            !matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.setAttribute("data-rings-intro", "");
          try { sessionStorage.setItem("entrelacos-opening", "seen"); } catch {}
        }
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f0e7" />
    <title>Entrelaços — sites de casamento</title>
    <meta name="description" content="Sites de casamento preparados para vocês, com confirmação de presença, mural, presentes em dinheiro e painel do casal. Conheça os modelos do Entrelaços." />
    <link rel="canonical" href={config.siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content="Entrelaços — sites de casamento" />
    <meta property="og:description" content="Conheça os modelos e reúna as informações do casamento, as confirmações e os recados dos convidados." />
    <meta property="og:url" content={config.siteUrl} />
    <meta property="og:image" content={new URL("social-card.png", config.siteUrl).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("social-card.png", config.siteUrl).href} />
    <meta property="og:image:alt" content="Duas alianças entrelaçadas, símbolo do Entrelaços." />
  </head>
  <body>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <LandingTracking config={config} />
    <PublicHeader contactUrl={config.contactUrl} home />
    <main id="conteudo" tabindex="-1">

      <section id="inicio" class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">

          <h1 id="hero-title" tabindex="-1" class="entrance">O site do seu<br /><em>casamento.</em></h1>
          <p class="hero-description entrance">Fotos, confirmações de presença e lista de presentes em dinheiro em um só lugar. Montamos o site com vocês, do jeito que imaginam, e vocês acompanham convidados e presentes pelo painel.</p>
          <p class="hero-offer entrance">A partir de {modelPrice} · pronto em {siteDeliveryLabel}</p>
          <div class="hero-actions entrance" data-track-position="inicio">
            <a class="button button-wine" href={config.contactUrl}>{contactLabel}<span aria-hidden="true">↗</span></a>
            <a class="button button-outline" href="#modelos">Explorar modelos <span aria-hidden="true">↗</span></a>
          </div>

        </div>
        <div class="union-art" aria-hidden="true">
          <div class="union-scene"><div class="union-halo"></div>

          <div class="union-stage">
            <div class="alliance alliance-first">{Array.from({ length: 12 }, (_, slice) => <i class="alliance-slice" style={`--slice: ${slice}`}></i>)}</div>
            <div class="alliance alliance-second">{Array.from({ length: 12 }, (_, slice) => <i class="alliance-slice" style={`--slice: ${slice}`}></i>)}</div>
          </div>
          <div class="union-shadow"></div></div>



        </div>

      </section>

      <section id="modelos" class="models chapter" aria-labelledby="models-title">
        <div class="section-heading reveal"><div><h2 id="models-title">Escolham o modelo<br /><em>de vocês.</em></h2></div><p>Dois estilos, com as mesmas ferramentas para organizar o casamento. Personalizamos fotos, cores e textos com vocês.</p></div>
        <div class="model-grid">
          <article class="model model-botanical">
            <a href={config.botanicalUrl} target="_blank" rel="noopener noreferrer" class="model-scene reveal" aria-label="Explorar o site de demonstração Cinema Botânico (abre em nova aba)">
              <div class="browser-trim" aria-hidden="true"><span>● ● ●</span><span>CINEMA BOTÂNICO</span><span>↗</span></div>
              <div class="botanical-cover abstract-botanical"><svg class="botanical-branch" viewBox="0 0 300 400" fill="none" aria-hidden="true"><path d="M80 410C200 240 120 130 260-20" stroke="currentColor" stroke-width="2"/><path d="M137 300C25 280 35 215 140 258C213 226 259 247 137 300ZM163 218C64 192 78 131 166 179C237 156 278 183 163 218ZM193 124C120 100 135 51 207 87C269 72 293 93 193 124Z" fill="currentColor"/></svg><div class="cover-copy"><small>FOTOGRAFIA E MOVIMENTO</small><span>A nossa<br /><i>história.</i></span><small>CINEMA BOTÂNICO</small></div></div>
              <div class="preview-foot"><span>Prévia do estilo botânico</span><span aria-hidden="true">↓</span></div>
            </a>
            <div class="model-meta reveal"><div><h3>Cinema Botânico</h3><p>Vídeo de abertura, galeria de fotos e tons de verde oliva.</p><a href={config.botanicalUrl} target="_blank" rel="noopener noreferrer" class="text-link">Ver demonstração <span class="sr-only">(abre em nova aba)</span><span aria-hidden="true">↗</span></a></div><div class="swatches" aria-label="Paleta oliva e marfim"><i></i><i></i></div></div>
          </article>
          <article class="model model-letters">
            <a href={config.lettersUrl} target="_blank" rel="noopener noreferrer" class="model-scene reveal" aria-label="Explorar o site de demonstração Cartas do Nosso Sim (abre em nova aba)">
              <div class="browser-trim" aria-hidden="true"><span>● ● ●</span><span>CARTAS DO NOSSO SIM</span><span>↗</span></div>
              <div class="letter-cover abstract-letter"><span class="letter-monogram">nós <i>/</i> dois</span><div class="letter-preview-title"><small>CARTAS DO NOSSO SIM</small><span>O nosso<br /><i>sim.</i></span><p>Uma carta para a família<br />e os amigos.</p></div><div class="letter-envelope" aria-hidden="true"><span>para: quem faz parte.</span><i>∞</i></div><span class="letter-signature">Com carinho, vocês dois.</span></div>
              <div class="preview-foot"><span>Prévia do estilo carta</span><span aria-hidden="true">↓</span></div>
            </a>
            <div class="model-meta reveal"><div><h3>Cartas do Nosso Sim</h3><p>Uma carta do casal, fotografias e tons de vinho sobre papel claro.</p><a href={config.lettersUrl} target="_blank" rel="noopener noreferrer" class="text-link">Ver demonstração <span class="sr-only">(abre em nova aba)</span><span aria-hidden="true">↗</span></a></div><div class="swatches" aria-label="Paleta vinho e papel"><i></i><i></i></div></div>
          </article>
        </div>
        <p class="section-note">As demonstrações apresentam um casamento fictício e abrem em uma nova aba.</p>
      </section>



      <section id="convidados" class="people chapter" aria-labelledby="people-title">
        <div id="experiencia" class="people-copy reveal"><h2 id="people-title">Acompanhem<br />cada <em>confirmação.</em></h2><p>Organizem a lista por família e vejam quem confirmou ou ainda não respondeu. Cada grupo acessa o convite com telefone e PIN.</p><p>Os recados aparecem no mural do site. Pelo painel do casal, vocês também podem moderar as mensagens.</p><a href={new URL("#mural", config.lettersUrl).href} class="text-link">Ver o mural na demonstração <span aria-hidden="true">↗</span></a></div>
        <div id="dashboard" class="guest-composition">
          <div class="guest-list reveal"><div class="list-heading"><span>PAINEL DO CASAL</span><svg class="invitation-ornament" viewBox="0 0 40 32" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="5" width="34" height="23" rx="2"/><path d="m4 7 16 12L36 7M4 27l11-10m21 10L25 17"/></svg></div><h3>Confirmações por família</h3><div class="guest-row"><span>Convidada</span><strong>✓ Confirmada</strong></div><div class="guest-row"><span>Convidado</span><strong>✓ Confirmado</strong></div><div class="guest-row"><span>Acompanhante</span><em>Resposta pendente</em></div><p>Exemplo de uma família na lista de convidados.</p></div>
          <blockquote class="guest-message reveal"><span class="quote-mark" aria-hidden="true">“</span><p>Já reservei a data. Até setembro!</p><footer><span>MENSAGEM ILUSTRATIVA</span></footer></blockquote>
        </div>
      </section>

      <section id="presentes" class="gifts chapter" aria-labelledby="gifts-title">
        <div class="gift-object reveal" aria-hidden="true"><div class="gift-box"><div class="gift-lid"><div class="gift-top"></div><div class="gift-bow bow-one"></div><div class="gift-bow bow-two"></div></div><div class="gift-glow"></div><div class="gift-wishes">{[
          ["-85px", "-160px", "-60deg"],
          ["65px", "-185px", "85deg"],
          ["105px", "-105px", "120deg"],
          ["-45px", "-205px", "-110deg"],
        ].map(([x, y, turn]) => <i class="gift-spark" style={`--spark-x: ${x}; --spark-y: ${y}; --spark-turn: ${turn}`}></i>)}<span class="gift-wish wish-affection">com carinho <i>♡</i></span><span class="gift-wish wish-plans">novos planos <i>∞</i></span></div><div class="gift-front"></div><div class="gift-side"></div><span class="gift-tag">para a vida<br /><i>a dois.</i></span></div><span class="gift-shadow"></span></div>
        <div class="gift-copy reveal"><h2 id="gifts-title">Presentes para<br /><em>os planos do casal.</em></h2><p>Montem uma lista para a lua de mel, a casa ou outros planos de vocês. Os convidados escolhem um item e contribuem no Pix ou no cartão em até {GIFT_PLATFORM_TARIFFS.maxInstallments}x.</p><p class="gift-promise"><strong>Vocês recebem 100% do valor de cada presente.</strong> As taxas ficam com o convidado e aparecem antes de ele pagar: num presente de {exampleGift}, o convidado paga {examplePix} no Pix e {exampleGift} entram no saldo de vocês.</p><p>No Pix, o valor fica disponível assim que o pagamento é confirmado; no cartão, em até 2 dias úteis. Vocês sacam para a conta bancária que escolherem, com tarifa de {withdrawalFee} por saque.</p><p class="fine-print">Para receber, um de vocês cadastra CPF e conta bancária no painel. A conferência é automática: não pedimos selfie nem envio de documentos. Os presentes são contribuições, sem entrega física. <a class="inline-link" href="/duvidas#taxas">Ver a simulação de taxas</a></p><PaymentSeal /></div>
      </section>

      <section id="planos" class="plans chapter" aria-labelledby="plans-title">
        <div class="plans-intro reveal"><h2 id="plans-title">Do primeiro contato<br /><em>à publicação.</em></h2><p>Vocês não montam nada sozinhos. A nossa equipe acompanha o casal do fechamento ao lançamento e segue disponível para suporte enquanto o site estiver no ar.</p></div>
        <div class="plan-grid">
          <article class="plan reveal" aria-labelledby="plan-model-title">
            <h3 id="plan-model-title">Site Modelo</h3>
            <p class="plan-price">{modelPrice}</p>
            <p>Um dos nossos estilos, com as fotos, as cores e os textos de vocês.</p>
            <ul><li>Site completo do casamento</li><li>Painel do casal com login</li><li>Convidados e confirmações por família</li><li>Lista de presentes e recebimentos</li><li>Mural de mensagens</li><li>Site no ar {siteOnlineLabel}</li></ul>
            <p class="plan-terms">Pronto em {siteDeliveryLabel}, contados a partir do recebimento de todo o material. Pix, boleto ou cartão em até {SITE_PLANS.model.maxInstallments}x.</p>
          </article>
          <article class="plan plan-exclusive reveal" aria-labelledby="plan-exclusive-title">
            <h3 id="plan-exclusive-title">Site Exclusivo</h3>
            <p class="plan-price"><small>a partir de</small> {exclusivePrice}</p>
            <p>Seções e estrutura feitas sob medida, para um site só de vocês.</p>
            <ul><li>Tudo o que o Site Modelo inclui</li><li>Estrutura e seções sob medida</li><li>Valor combinado antes de fechar</li></ul>
            <p class="plan-terms">Prazo de {exclusiveDeliveryLabel}, contado a partir do recebimento de todo o material.</p>
          </article>
        </div>
        <ol class="process-list reveal">{steps.map(([title, text]) => <li><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol>
      </section>

      <section id="detalhes" class="faq chapter" aria-labelledby="faq-title"><div class="faq-intro"><h2 id="faq-title">Dúvidas frequentes</h2><a class="faq-more" href="/duvidas">Ver todas as dúvidas <span aria-hidden="true">↗</span></a></div><div class="faq-list">{questions.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>

      <section id="comecar" class="closing" aria-labelledby="closing-title"><h2 id="closing-title" class="reveal">Vamos preparar<br /><em>o site de vocês?</em></h2><div class="closing-actions reveal" data-track-position="fechamento"><a class="button button-ivory" href={config.contactUrl}>{contactLabel}<span aria-hidden="true">↗</span></a><p>Contem a data do casamento e o modelo que vocês gostaram.</p></div></section>
    </main>
    <div class="sticky-contact" data-track-position="fixo">
      <a class="button button-wine" href={config.contactUrl}>{contactLabel}<span aria-hidden="true">↗</span></a>
    </div>
    <PublicFooter config={config} home />
    <script>
      import Lenis from "lenis";
      import { mountLandingMotion } from "../landingMotion";
      mountLandingMotion(
        document,
        window,
        window.matchMedia("(prefers-reduced-motion: reduce)"),
        (options) => new Lenis(options),
      );
    </script>
    <script>
      import { mountStickyContact } from "../stickyContact";
      mountStickyContact(document);
    </script>
  </body>
</html>
