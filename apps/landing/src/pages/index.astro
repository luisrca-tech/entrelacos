---
import "../styles/landing.css";
import "../styles/cinematic.css";
import "lenis/dist/lenis.css";
import { landingConfig } from "../landingConfig";
const config = landingConfig(import.meta.env, import.meta.env.PROD);
const navigationLinks = [
  ["#modelos", "Modelos"],
  ["#convidados", "Convidados"],
  ["#detalhes", "Dúvidas"],
];
const contactLabel = new URL(config.contactUrl).hostname === "wa.me"
  ? "Falar no WhatsApp"
  : "Solicitar proposta";
const questions = [
  ["Podemos personalizar o site?", "Sim. Escolhemos o modelo e organizamos as fotos, os textos e as informações do casamento com vocês. O Entrelaços cuida da montagem e da publicação; vocês cuidam dos convidados pelo painel."],
  ["O que podemos gerenciar pelo painel?", "Vocês podem cadastrar famílias e convidados, acompanhar confirmações, moderar o mural e gerenciar a lista de presentes. Os recebimentos ficam disponíveis conforme a configuração da conta do casamento."],
  ["Como funcionam os presentes em dinheiro?", "Os itens da lista representam contribuições para o casal, sem entrega de produtos físicos. O convidado escolhe o presente e segue para o pagamento. O recebimento depende da conta configurada e habilitada para o casamento. Taxas, forma de pagamento e condições são apresentadas no fluxo; os prazos seguem o serviço de pagamento."],
  ["Os convidados precisam criar uma conta?", "Não. Para confirmar presença, a família usa o telefone de contato cadastrado e o PIN recebido com o convite. As informações do evento ficam disponíveis no site."],
  ["Podemos usar no celular?", "Sim. Os sites e o painel têm versões que se adaptam ao celular. O convidado pode consultar as informações, confirmar presença e deixar sua mensagem pelo próprio aparelho."],
  ["Como combinamos valores e prazo de entrega?", "Depois de escolher o estilo, conversamos sobre a data, o conteúdo e o que vocês precisam. Valores, prazo de preparação, período de publicação e eventuais custos adicionais são combinados antes da contratação."],
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Release the opening lock if the deferred module cannot start.
      try {
        const navigation = performance.getEntriesByType?.("navigation")[0];
        if (!location.hash && navigation?.type !== "back_forward" &&
            !matchMedia("(prefers-reduced-motion: reduce)").matches) {
          const root = document.documentElement;
          const listeners = new AbortController();
          root.dataset.opening = "armed";
          root.setAttribute("inert", "");
          const release = () => {
            if (root.dataset.opening === "armed") {
              delete root.dataset.opening;
              root.removeAttribute("inert");
            }
            clearTimeout(deadline);
            listeners.abort();
          };
          const deadline = setTimeout(release, 1200);
          for (const type of ["pagehide", "opening:ready"]) {
            window.addEventListener(type, release, { signal: listeners.signal });
          }
        }
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f0e7" />
    <title>Entrelaços — sites de casamento</title>
    <meta name="description" content="Sites de casamento preparados para vocês, com confirmação de presença, mural, presentes em dinheiro e painel do casal. Conheça os modelos do Entrelaços." />
    <link rel="canonical" href={config.siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content="Entrelaços — sites de casamento" />
    <meta property="og:description" content="Conheça os modelos e reúna as informações do casamento, as confirmações e os recados dos convidados." />
    <meta property="og:url" content={config.siteUrl} />
    <meta property="og:image" content={new URL("social-card.png", config.siteUrl).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("social-card.png", config.siteUrl).href} />
    <meta property="og:image:alt" content="Duas alianças entrelaçadas, símbolo do Entrelaços." />
  </head>
  <body>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
    <header class="masthead">
      <a href="#inicio" class="wordmark" aria-label="Entrelaços, início"><img class="brand-mark" src="/brand/entrelacos-mark.svg" width="44" height="41" alt="" aria-hidden="true" />Entrelaços</a>
      <nav class="masthead-links" aria-label="Navegação principal">
        {navigationLinks.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
      <a class="header-cta" href={config.contactUrl}>{contactLabel}<span aria-hidden="true">↗</span></a>
      <details class="masthead-menu">
        <summary aria-label="Menu principal">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </summary>
        <nav aria-label="Navegação principal">
          {navigationLinks.map(([href, label]) => <a href={href}>{label}</a>)}
          <a href={config.contactUrl}>{contactLabel}<span aria-hidden="true"> ↗</span></a>
        </nav>
      </details>
    </header>
    <main id="conteudo" tabindex="-1">

      <section id="inicio" class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">

          <h1 id="hero-title" tabindex="-1" class="entrance">O site do seu<br /><em>casamento.</em></h1>
          <p class="hero-description entrance">Fotos, informações e confirmações em um só lugar. Nós preparamos o site; vocês acompanham os convidados pelo painel.</p>
          <div class="hero-actions entrance"><a href="#modelos" class="button button-wine">Conhecer os modelos <span aria-hidden="true">↗</span></a></div>

        </div>
        <div class="union-art" aria-hidden="true">
          <div class="union-scene"><div class="union-halo"></div>

          <div class="union-stage">
            <div class="alliance alliance-first">{Array.from({ length: 12 }, (_, slice) => <i class="alliance-slice" style={`--slice: ${slice}`}></i>)}</div>
            <div class="alliance alliance-second">{Array.from({ length: 12 }, (_, slice) => <i class="alliance-slice" style={`--slice: ${slice}`}></i>)}</div>
          </div>
          <div class="union-shadow"></div></div>



        </div>

      </section>

      <section id="modelos" class="models chapter" aria-labelledby="models-title">
        <div class="section-heading reveal"><div><h2 id="models-title">Escolham o modelo<br /><em>de vocês.</em></h2></div><p>Dois estilos, com as mesmas ferramentas para organizar o casamento. Personalizamos fotos, cores e textos com vocês.</p></div>
        <div class="model-grid">
          <article class="model model-botanical">
            <a href={config.botanicalUrl} target="_blank" rel="noopener noreferrer" class="model-scene reveal" aria-label="Explorar o site de demonstração Cinema Botânico (abre em nova aba)">
              <div class="browser-trim" aria-hidden="true"><span>● ● ●</span><span>CINEMA BOTÂNICO</span><span>↗</span></div>
              <div class="botanical-cover abstract-botanical"><svg class="botanical-branch" viewBox="0 0 300 400" fill="none" aria-hidden="true"><path d="M80 410C200 240 120 130 260-20" stroke="currentColor" stroke-width="2"/><path d="M137 300C25 280 35 215 140 258C213 226 259 247 137 300ZM163 218C64 192 78 131 166 179C237 156 278 183 163 218ZM193 124C120 100 135 51 207 87C269 72 293 93 193 124Z" fill="currentColor"/></svg><div class="cover-copy"><small>FOTOGRAFIA E MOVIMENTO</small><span>A nossa<br /><i>história.</i></span><small>CINEMA BOTÂNICO</small></div></div>
              <div class="preview-foot"><span>Prévia do estilo botânico</span><span aria-hidden="true">↓</span></div>
            </a>
            <div class="model-meta reveal"><div><h3>Cinema Botânico</h3><p>Vídeo de abertura, galeria de fotos e tons de verde oliva.</p><a href={config.botanicalUrl} target="_blank" rel="noopener noreferrer" class="text-link">Ver demonstração <span class="sr-only">(abre em nova aba)</span><span aria-hidden="true">↗</span></a></div><div class="swatches" aria-label="Paleta oliva e marfim"><i></i><i></i></div></div>
          </article>
          <article class="model model-letters">
            <a href={config.lettersUrl} target="_blank" rel="noopener noreferrer" class="model-scene reveal" aria-label="Explorar o site de demonstração Cartas do Nosso Sim (abre em nova aba)">
              <div class="browser-trim" aria-hidden="true"><span>● ● ●</span><span>CARTAS DO NOSSO SIM</span><span>↗</span></div>
              <div class="letter-cover abstract-letter"><span class="letter-monogram">nós <i>/</i> dois</span><div class="letter-preview-title"><small>CARTAS DO NOSSO SIM</small><span>O nosso<br /><i>sim.</i></span><p>Uma carta para a família<br />e os amigos.</p></div><div class="letter-envelope" aria-hidden="true"><span>para: quem faz parte.</span><i>∞</i></div><span class="letter-signature">Com carinho, vocês dois.</span></div>
              <div class="preview-foot"><span>Prévia do estilo carta</span><span aria-hidden="true">↓</span></div>
            </a>
            <div class="model-meta reveal"><div><h3>Cartas do Nosso Sim</h3><p>Uma carta do casal, fotografias e tons de vinho sobre papel claro.</p><a href={config.lettersUrl} target="_blank" rel="noopener noreferrer" class="text-link">Ver demonstração <span class="sr-only">(abre em nova aba)</span><span aria-hidden="true">↗</span></a></div><div class="swatches" aria-label="Paleta vinho e papel"><i></i><i></i></div></div>
          </article>
        </div>
        <p class="section-note">As demonstrações apresentam um casamento fictício e abrem em uma nova aba.</p>
      </section>



      <section id="convidados" class="people chapter" aria-labelledby="people-title">
        <div id="experiencia" class="people-copy reveal"><h2 id="people-title">Acompanhem<br />cada <em>confirmação.</em></h2><p>Organizem a lista por família e vejam quem confirmou ou ainda não respondeu. Cada grupo acessa o convite com telefone e PIN.</p><p>Os recados aparecem no mural do site. Pelo painel do casal, vocês também podem moderar as mensagens.</p><a href={new URL("#mural", config.lettersUrl).href} class="text-link">Ver o mural na demonstração <span aria-hidden="true">↗</span></a></div>
        <div id="dashboard" class="guest-composition">
          <div class="guest-list reveal"><div class="list-heading"><span>PAINEL DO CASAL</span><svg class="invitation-ornament" viewBox="0 0 40 32" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="5" width="34" height="23" rx="2"/><path d="m4 7 16 12L36 7M4 27l11-10m21 10L25 17"/></svg></div><h3>Confirmações por família</h3><div class="guest-row"><span>Convidada</span><strong>✓ Confirmada</strong></div><div class="guest-row"><span>Convidado</span><strong>✓ Confirmado</strong></div><div class="guest-row"><span>Acompanhante</span><em>Resposta pendente</em></div><p>Exemplo de uma família na lista de convidados.</p></div>
          <blockquote class="guest-message reveal"><span class="quote-mark" aria-hidden="true">“</span><p>Já reservei a data. Até setembro!</p><footer><span>MENSAGEM ILUSTRATIVA</span></footer></blockquote>
        </div>
      </section>

      <section id="presentes" class="gifts chapter" aria-labelledby="gifts-title">
        <div class="gift-object reveal" aria-hidden="true"><div class="gift-box"><div class="gift-lid"><div class="gift-top"></div><div class="gift-bow bow-one"></div><div class="gift-bow bow-two"></div></div><div class="gift-glow"></div><div class="gift-wishes">{[
          ["-85px", "-160px", "-60deg"],
          ["65px", "-185px", "85deg"],
          ["105px", "-105px", "120deg"],
          ["-45px", "-205px", "-110deg"],
        ].map(([x, y, turn]) => <i class="gift-spark" style={`--spark-x: ${x}; --spark-y: ${y}; --spark-turn: ${turn}`}></i>)}<span class="gift-wish wish-affection">com carinho <i>♡</i></span><span class="gift-wish wish-plans">novos planos <i>∞</i></span></div><div class="gift-front"></div><div class="gift-side"></div><span class="gift-tag">para a vida<br /><i>a dois.</i></span></div><span class="gift-shadow"></span></div>
        <div class="gift-copy reveal"><h2 id="gifts-title">Presentes para<br /><em>os planos do casal.</em></h2><p>Montem uma lista para a lua de mel, a casa ou outros planos de vocês.</p><p>Os convidados escolhem um item e contribuem em dinheiro. Vocês gerenciam a lista e acompanham os recebimentos pelo painel.</p><p class="fine-print">Os presentes são contribuições, sem entrega física. Recebimento sujeito à habilitação da conta; taxas e condições aparecem no pagamento.</p></div>
      </section>

      <section class="process chapter" aria-labelledby="process-title"><div class="process-intro reveal"><h2 id="process-title">Como preparamos<br /><em>o site de vocês.</em></h2></div><ol class="process-list"><li><div><h3>Escolha do modelo</h3><p>Vocês escolhem um estilo. Combinamos o conteúdo, o prazo e os valores antes de começar.</p></div></li><li><div><h3>Montagem e revisão</h3><p>Enviem as fotos, os textos e os dados do casamento. Nós montamos o site e vocês conferem antes da publicação.</p></div></li><li><div><h3>Publicação</h3><p>Publicamos o site e preparamos o painel. Vocês recebem o link para compartilhar e organizam os convidados.</p></div></li></ol></section>

      <section id="detalhes" class="faq chapter" aria-labelledby="faq-title"><div class="faq-intro"><h2 id="faq-title">Dúvidas frequentes</h2></div><div class="faq-list">{questions.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>

      <section id="comecar" class="closing" aria-labelledby="closing-title"><h2 id="closing-title" class="reveal">Vamos preparar<br /><em>o site de vocês?</em></h2><div class="closing-actions reveal"><a class="button button-ivory" href={config.contactUrl}>{contactLabel}<span aria-hidden="true">↗</span></a><p>Contem a data do casamento e o modelo que vocês gostaram.</p></div></section>
    </main>
    <footer class="site-footer"><a class="wordmark" href="#inicio" aria-label="Entrelaços, início"><img class="brand-mark" src="/brand/entrelacos-mark.svg" width="44" height="41" alt="" aria-hidden="true" />Entrelaços</a><p>Sites de casamento<br />preparados para vocês.</p><div><a href={config.botanicalUrl} target="_blank" rel="noopener noreferrer">Cinema Botânico ↗</a><a href={config.lettersUrl} target="_blank" rel="noopener noreferrer">Cartas do Nosso Sim ↗</a></div><small>© {new Date().getFullYear()} Entrelaços.</small></footer>
    <script>
      import Lenis from "lenis";
      import { mountLandingMotion } from "../landingMotion";
      mountLandingMotion(
        document,
        window,
        window.matchMedia("(prefers-reduced-motion: reduce)"),
        (options) => new Lenis(options),
      );
    </script>
  </body>
</html>
