{
  "name": "entrelacos",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24 <25",
    "bun": "1.3.14"
  },
  "scripts": {
    "dev": "NO_COLOR=0 turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "24.13.4",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ]
}
