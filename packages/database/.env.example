# Server-side runtime connection; pooling is allowed. Choose the environment explicitly.
# Never use main for tests. Never place these values in PUBLIC_* or VITE_* variables.
DATABASE_URL=
# Migrations require a direct, unpooled connection to the same endpoint/database.
# A separate migration role is allowed. There is no DATABASE_URL fallback.
DATABASE_DIRECT_URL=
DATABASE_URL_TEST=
# Development/test identity guards only. Production derives its checks from DATABASE_URL.
DATABASE_PROJECT_ID=
DATABASE_DEVELOPMENT_BRANCH_ID=
DATABASE_TEST_BRANCH_ID=
DATABASE_NAME=
