---
import type { SectionContent } from "../content";
import { validateSectionContent } from "../content";

interface Props {
  content: SectionContent;
}

const { content } = Astro.props;
validateSectionContent(content);
---

<section
  id={content.id}
  hidden
  data-gift-section
  class="grid min-w-0 gap-10 bg-template-ivory px-[var(--template-page-inset)] py-[clamp(4rem,8vw,7rem)] text-template-ink"
  aria-labelledby={`${content.id}-title`}
>
  <header class="grid min-w-0 gap-5">
    {content.eyebrow && <p class="m-0 text-[0.72rem] font-bold uppercase tracking-[0.16em]">{content.eyebrow}</p>}
    <h2 id={`${content.id}-title`} class="m-0 max-w-[16ch] font-template-serif text-[clamp(2.5rem,6vw,5.5rem)] font-normal leading-[0.96] tracking-[-0.065em]">{content.title}</h2>
    {content.description && <p class="m-0 max-w-[38rem] leading-[1.7] text-template-muted">{content.description}</p>}
  </header>
  <div class="min-w-0"><slot /></div>
</section>

<style>
  [data-gift-section][hidden] { display: none; }
</style>
