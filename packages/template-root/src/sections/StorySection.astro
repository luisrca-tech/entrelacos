---
import { validateStoryContent } from "../content";
import type { StoryContent } from "../content";
import { storyBackgroundFrames } from "./storyMediaCycle";

interface Props {
  content: StoryContent;
  tone?: "ivory" | "olive";
}

const { content, tone = "ivory" } = Astro.props;
validateStoryContent(content);
const id = content.id;
const frames = storyBackgroundFrames({
  media: content.media,
  sequence: content.sequence,
});
const primary = frames[0] ?? content.media;
---

<section
  id={id}
  class:list={["template-story", `template-story--${tone}`]}
  data-template-story
  aria-labelledby={`${id}-title`}
  style={`--story-media-ratio: ${primary.width} / ${primary.height};`}
>
  <figure class="template-story__media">
    {content.media.kind === "image" ? (
      frames.map((frame, index) =>
        frame.kind === "image" ? (
          <img
            src={frame.src}
            alt={index === 0 ? frame.alt : ""}
            width={frame.width}
            height={frame.height}
            loading="lazy"
            decoding="async"
            data-story-frame
            class:list={{ "is-active": index === 0 }}
            aria-hidden={index === 0 ? undefined : "true"}
          />
        ) : null,
      )
    ) : (
      <video
        src={content.media.src}
        poster={content.media.poster}
        width={content.media.width}
        height={content.media.height}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label={content.media.alt}
      >
        <img
          src={content.media.poster}
          alt={content.media.alt}
          width={content.media.width}
          height={content.media.height}
          loading="lazy"
        />
      </video>
    )}
  </figure>
  <div class="template-story__veil" aria-hidden="true"></div>
  <div class="template-story__copy" data-story-copy>
    {content.eyebrow && <p class="template-story__eyebrow">{content.eyebrow}</p>}
    <h2 id={`${id}-title`}>{content.title}</h2>
    {content.description && <p class="template-story__description">{content.description}</p>}
    <p class="template-story__body">{content.body}</p>
  </div>
</section>

<script>
  import { setupStoryMediaCycle } from "./storyMediaCycle";

  const reducedMotion = window.matchMedia?.(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  document.querySelectorAll<HTMLElement>("[data-template-story]").forEach((story) => {
    if (story.dataset.storyCycle === "ready") return;
    story.dataset.storyCycle = "ready";

    const copy = story.querySelector<HTMLElement>("[data-story-copy]");
    if (
      !reducedMotion &&
      "IntersectionObserver" in window &&
      copy &&
      story.getAttribute("data-story-motion") !== "ready"
    ) {
      const observer = new IntersectionObserver(
        (observations) => {
          observations.forEach((observation) => {
            if (!observation.isIntersecting) return;
            observation.target.classList.add("is-visible");
            observer.unobserve(observation.target);
          });
        },
        { threshold: 0.18 },
      );

      story.setAttribute("data-story-motion", "ready");
      observer.observe(copy);
    }

    setupStoryMediaCycle(story, {
      reducedMotion,
      Observer: window.IntersectionObserver,
    });
  });
</script>
