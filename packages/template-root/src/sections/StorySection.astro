---
import { validateStoryContent } from "../content";
import type { StoryContent, StoryEntry } from "../content";

interface Props {
  content: StoryContent;
  tone?: "ivory" | "olive";
}

const { content, tone = "ivory" } = Astro.props;
validateStoryContent(content);
const id = content.id;
const entries: StoryEntry[] = [];
let hasMedia = false;
for (let index = 0; index < content.entries.length; index += 1) {
  const entry = content.entries[index];
  entries.push(entry);
  if (entry.media) hasMedia = true;
}
---

<section
  id={id}
  class:list={["template-story", `template-story--${tone}`]}
  data-template-story
  aria-labelledby={`${id}-title`}
>
  <header class="template-story__intro" data-template-reveal>
    <div class="template-story__heading">
      {content.eyebrow && <p class="template-story__eyebrow">{content.eyebrow}</p>}
      <h2 id={`${id}-title`}>{content.title}</h2>
    </div>
    <div class="template-story__summary">
      {content.description && <p class="template-story__description">{content.description}</p>}
      {content.body && <p class="template-story__body">{content.body}</p>}
    </div>
  </header>

  <div class="template-story__sequence">
    <div class="template-story__entries">
      {entries.map((entry, index) => (
        <article
          id={entry.id}
          class="template-story__entry"
          data-story-entry
          data-story-entry-index={index}
          style={`--story-entry-index: ${index};`}
          aria-labelledby={`${entry.id}-title`}
        >
          <div class="template-story__entry-copy">
            {entry.eyebrow && <p class="template-story__entry-eyebrow">{entry.eyebrow}</p>}
            <h3 id={`${entry.id}-title`}>{entry.title}</h3>
            <p>{entry.body}</p>
          </div>
          {entry.media && (
            <figure class="template-story__entry-media">
              {entry.media.kind === "image" ? (
                <img
                  src={entry.media.src}
                  alt={entry.media.alt}
                  width={entry.media.width}
                  height={entry.media.height}
                  loading="lazy"
                />
              ) : (
                <video
                  src={entry.media.src}
                  poster={entry.media.poster}
                  width={entry.media.width}
                  height={entry.media.height}
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-label={entry.media.alt}
                >
                  <img
                    src={entry.media.poster}
                    alt={entry.media.alt}
                    width={entry.media.width}
                    height={entry.media.height}
                    loading="lazy"
                  />
                </video>
              )}
            </figure>
          )}
        </article>
      ))}
    </div>

    {hasMedia && (
      <aside
        class="template-story__stage"
        data-story-stage
        aria-hidden="true"
      >
        {entries.map((entry, index) => entry.media && (
          <figure
            class="template-story__stage-media"
            data-story-media-index={index}
          >
            {entry.media.kind === "image" ? (
              <img
                src={entry.media.src}
                alt={entry.media.alt}
                width={entry.media.width}
                height={entry.media.height}
                loading="lazy"
              />
            ) : (
              <video
                src={entry.media.src}
                poster={entry.media.poster}
                width={entry.media.width}
                height={entry.media.height}
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={entry.media.alt}
              >
                <img
                  src={entry.media.poster}
                  alt={entry.media.alt}
                  width={entry.media.width}
                  height={entry.media.height}
                  loading="lazy"
                />
              </video>
            )}
          </figure>
        ))}
      </aside>
    )}
  </div>
</section>

<script>
  import {
    createStoryTransitionController,
    resolveStoryEntryIndex,
    type StoryScrollDirection,
  } from "./storyMotion";

  const reducedMotion = window.matchMedia?.(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!reducedMotion && "IntersectionObserver" in window) {
    document.querySelectorAll<HTMLElement>("[data-template-story]").forEach((story) => {
      if (story.getAttribute("data-story-motion") === "ready") return;
      const entries = story.querySelectorAll<HTMLElement>("[data-story-entry]");
      const stage = story.querySelector<HTMLElement>("[data-story-stage]");
      const media = story.querySelectorAll<HTMLElement>("[data-story-media-index]");
      const clearExitingMedia = () => {
        media.forEach((item) => item.removeAttribute("data-story-exiting"));
      };
      const transitionMedia = (index: number) => {
        const current = story.querySelector<HTMLElement>(
          "[data-story-media-index][data-active]",
        );
        const next = story.querySelector<HTMLElement>(
          `[data-story-media-index="${index}"]`,
        );
        // #region agent log
        fetch('http://127.0.0.1:7638/ingest/309c9a99-9d85-43d4-8f27-99b88384286d',{method:'POST',headers:{'Content-Type':'application/json','X-Debug-Session-Id':'8b3f1f'},body:JSON.stringify({sessionId:'8b3f1f',runId:'pre-fix',hypothesisId:'H3,H5',location:'StorySection.astro:transitionMedia',message:'Story media transition started',data:{storyId:story.id,fromIndex:Number(current?.getAttribute('data-story-media-index') ?? -1),toIndex:index,nextExists:Boolean(next)},timestamp:Date.now()})}).catch(()=>{});
        // #endregion
        if (!next || current === next) return;
        const currentStyle = current ? window.getComputedStyle(current) : undefined;
        const nextStyle = window.getComputedStyle(next);
        // #region agent log
        fetch('http://127.0.0.1:7638/ingest/309c9a99-9d85-43d4-8f27-99b88384286d',{method:'POST',headers:{'Content-Type':'application/json','X-Debug-Session-Id':'8b3f1f'},body:JSON.stringify({sessionId:'8b3f1f',runId:'iteration-2',hypothesisId:'H6,H7',location:'StorySection.astro:transitionMedia:computedStyle',message:'Story visual state before switch',data:{storyId:story.id,fromIndex:Number(current?.getAttribute('data-story-media-index') ?? -1),toIndex:index,currentClipPath:currentStyle?.clipPath,currentOpacity:currentStyle?.opacity,currentAnimationName:currentStyle?.animationName,nextClipPath:nextStyle.clipPath,nextOpacity:nextStyle.opacity},timestamp:Date.now()})}).catch(()=>{});
        // #endregion

        clearExitingMedia();
        if (current) {
          current.setAttribute("data-story-exiting", "");
          current.removeAttribute("data-active");
        }
        next.removeAttribute("data-story-exiting");
        next.setAttribute("data-active", "");
      };
      const firstMedia = media.item(0);
      const firstMediaIndex = Number(firstMedia?.getAttribute("data-story-media-index") ?? 0);
      firstMedia?.setAttribute("data-active", "");
      // #region agent log
      fetch('http://127.0.0.1:7638/ingest/309c9a99-9d85-43d4-8f27-99b88384286d',{method:'POST',headers:{'Content-Type':'application/json','X-Debug-Session-Id':'8b3f1f'},body:JSON.stringify({sessionId:'8b3f1f',runId:'pre-fix',hypothesisId:'H1,H5',location:'StorySection.astro:init',message:'Story motion initialized',data:{storyId:story.id,entryCount:entries.length,mediaCount:media.length,mediaIndices:Array.from(media,item=>Number(item.getAttribute('data-story-media-index'))),firstMediaIndex,viewportHeight:window.innerHeight,storyHeight:story.getBoundingClientRect().height},timestamp:Date.now()})}).catch(()=>{});
      // #endregion
      const transitionController = createStoryTransitionController({
        initialIndex: firstMediaIndex,
        duration: 420,
        onTransition: (_from, to) => transitionMedia(to),
        onSettled: () => {
          // #region agent log
          fetch('http://127.0.0.1:7638/ingest/309c9a99-9d85-43d4-8f27-99b88384286d',{method:'POST',headers:{'Content-Type':'application/json','X-Debug-Session-Id':'8b3f1f'},body:JSON.stringify({sessionId:'8b3f1f',runId:'pre-fix',hypothesisId:'H3',location:'StorySection.astro:onSettled',message:'Story media transition settled',data:{storyId:story.id,activeIndex:Number(story.querySelector('[data-story-media-index][data-active]')?.getAttribute('data-story-media-index') ?? -1)},timestamp:Date.now()})}).catch(()=>{});
          // #endregion
          clearExitingMedia();
        },
      });
      const revealObserver = new IntersectionObserver(
        (observations) => {
          observations.forEach((observation) => {
            if (!observation.isIntersecting) return;
            observation.target.classList.add("is-visible");
          });
        },
        { threshold: 0.14 },
      );
      let focusedIndex = firstMediaIndex;
      let lastScrollY = window.scrollY;
      let scrollFrame: number | undefined;
      const updateMediaFromScroll = () => {
        scrollFrame = undefined;
        const currentScrollY = window.scrollY;
        const direction: StoryScrollDirection =
          currentScrollY > lastScrollY
            ? 1
            : currentScrollY < lastScrollY
              ? -1
              : 0;
        lastScrollY = currentScrollY;
        const previousFocusedIndex = focusedIndex;
        const entryTops = Array.from(
          entries,
          (entry) => entry.getBoundingClientRect().top,
        );
        focusedIndex = resolveStoryEntryIndex(
          entryTops,
          focusedIndex,
          direction,
          window.innerHeight,
        );
        const focusedMediaExists = Boolean(
          story.querySelector(`[data-story-media-index="${focusedIndex}"]`),
        );
        // #region agent log
        fetch('http://127.0.0.1:7638/ingest/309c9a99-9d85-43d4-8f27-99b88384286d',{method:'POST',headers:{'Content-Type':'application/json','X-Debug-Session-Id':'8b3f1f'},body:JSON.stringify({sessionId:'8b3f1f',runId:'pre-fix',hypothesisId:'H1,H2,H3,H4',location:'StorySection.astro:updateMediaFromScroll',message:'Story scroll resolved focus',data:{storyId:story.id,scrollY:currentScrollY,direction,previousFocusedIndex,focusedIndex,entryTops:entryTops.map(top=>Math.round(top)),forwardLine:Math.round(window.innerHeight*0.42),reverseLine:Math.round(window.innerHeight*0.58),focusedMediaExists},timestamp:Date.now()})}).catch(()=>{});
        // #endregion
        if (focusedMediaExists) {
          transitionController.request(focusedIndex);
        }
      };
      const scheduleMediaUpdate = () => {
        if (scrollFrame !== undefined) return;
        scrollFrame = window.requestAnimationFrame(updateMediaFromScroll);
      };
      story.setAttribute("data-story-motion", "ready");
      if (stage) {
        story.setAttribute("data-story-stage-ready", "");
        stage.setAttribute("data-story-stage-ready", "");
        const logStoryAnimationEvent = (event: AnimationEvent) => {
          const target = event.target;
          if (!(target instanceof HTMLElement)) return;
          const style = window.getComputedStyle(target);
          // #region agent log
          fetch('http://127.0.0.1:7638/ingest/309c9a99-9d85-43d4-8f27-99b88384286d',{method:'POST',headers:{'Content-Type':'application/json','X-Debug-Session-Id':'8b3f1f'},body:JSON.stringify({sessionId:'8b3f1f',runId:'iteration-2',hypothesisId:'H6,H7,H8',location:'StorySection.astro:storyAnimationEvent',message:'Story animation lifecycle event',data:{storyId:story.id,eventType:event.type,mediaIndex:Number(target.getAttribute('data-story-media-index') ?? -1),elapsedTime:event.elapsedTime,clipPath:style.clipPath,opacity:style.opacity,isActive:target.hasAttribute('data-active'),isExiting:target.hasAttribute('data-story-exiting')},timestamp:Date.now()})}).catch(()=>{});
          // #endregion
        };
        stage.addEventListener("animationstart", logStoryAnimationEvent);
        stage.addEventListener("animationcancel", logStoryAnimationEvent);
        stage.addEventListener("animationend", logStoryAnimationEvent);
      }
      entries.forEach((entry) => {
        revealObserver.observe(entry);
      });
      window.addEventListener("scroll", scheduleMediaUpdate, { passive: true });
      window.addEventListener("resize", scheduleMediaUpdate, { passive: true });
      scheduleMediaUpdate();
    });
  }
</script>
