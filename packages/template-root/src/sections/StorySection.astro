---
import { validateStoryContent } from "../content";
import type { StoryContent, StoryEntry } from "../content";

interface Props {
  content: StoryContent;
  tone?: "ivory" | "olive";
}

const { content, tone = "ivory" } = Astro.props;
validateStoryContent(content);
const id = content.id;
const entries: StoryEntry[] = [];
let hasMedia = false;
for (let index = 0; index < content.entries.length; index += 1) {
  const entry = content.entries[index];
  entries.push(entry);
  if (entry.media) hasMedia = true;
}
---

<section
  id={id}
  class:list={["template-story", `template-story--${tone}`]}
  data-template-story
  aria-labelledby={`${id}-title`}
>
  <header class="template-story__intro" data-template-reveal>
    <div class="template-story__heading">
      {content.eyebrow && <p class="template-story__eyebrow">{content.eyebrow}</p>}
      <h2 id={`${id}-title`}>{content.title}</h2>
    </div>
    <div class="template-story__summary">
      {content.description && <p class="template-story__description">{content.description}</p>}
      {content.body && <p class="template-story__body">{content.body}</p>}
    </div>
  </header>

  <div class="template-story__sequence">
    <div class="template-story__entries">
      {entries.map((entry, index) => (
        <article
          id={entry.id}
          class="template-story__entry"
          data-story-entry
          data-story-entry-index={index}
          style={`--story-entry-index: ${index};`}
          aria-labelledby={`${entry.id}-title`}
        >
          <div class="template-story__entry-copy">
            {entry.eyebrow && <p class="template-story__entry-eyebrow">{entry.eyebrow}</p>}
            <h3 id={`${entry.id}-title`}>{entry.title}</h3>
            <p>{entry.body}</p>
          </div>
          {entry.media && (
            <figure class="template-story__entry-media">
              {entry.media.kind === "image" ? (
                <img
                  src={entry.media.src}
                  alt={entry.media.alt}
                  width={entry.media.width}
                  height={entry.media.height}
                  loading="lazy"
                />
              ) : (
                <video
                  src={entry.media.src}
                  poster={entry.media.poster}
                  width={entry.media.width}
                  height={entry.media.height}
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-label={entry.media.alt}
                >
                  <img
                    src={entry.media.poster}
                    alt={entry.media.alt}
                    width={entry.media.width}
                    height={entry.media.height}
                    loading="lazy"
                  />
                </video>
              )}
            </figure>
          )}
        </article>
      ))}
    </div>

    {hasMedia && (
      <aside
        class="template-story__stage"
        data-story-stage
        aria-hidden="true"
      >
        {entries.map((entry, index) => entry.media && (
          <figure
            class="template-story__stage-media"
            data-story-media-index={index}
          >
            {entry.media.kind === "image" ? (
              <img
                src={entry.media.src}
                alt={entry.media.alt}
                width={entry.media.width}
                height={entry.media.height}
                loading="lazy"
              />
            ) : (
              <video
                src={entry.media.src}
                poster={entry.media.poster}
                width={entry.media.width}
                height={entry.media.height}
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={entry.media.alt}
              >
                <img
                  src={entry.media.poster}
                  alt={entry.media.alt}
                  width={entry.media.width}
                  height={entry.media.height}
                  loading="lazy"
                />
              </video>
            )}
          </figure>
        ))}
      </aside>
    )}
  </div>
</section>

<script>
  const reducedMotion = window.matchMedia?.(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!reducedMotion && "IntersectionObserver" in window) {
    document.querySelectorAll<HTMLElement>("[data-template-story]").forEach((story) => {
      if (story.getAttribute("data-story-motion") === "ready") return;
      const entries = story.querySelectorAll<HTMLElement>("[data-story-entry]");
      const stage = story.querySelector<HTMLElement>("[data-story-stage]");
      const media = story.querySelectorAll<HTMLElement>("[data-story-media-index]");
      const setActiveMedia = (index: string) => {
        media.forEach((item) => {
          item.toggleAttribute(
            "data-active",
            item.getAttribute("data-story-media-index") === index,
          );
        });
      };
      const firstMedia = media.item(0);
      if (firstMedia) setActiveMedia(firstMedia.getAttribute("data-story-media-index") ?? "");
      const observer = new IntersectionObserver(
        (observations) => {
          observations.forEach((observation) => {
            if (!observation.isIntersecting) return;
            observation.target.classList.add("is-visible");
            const index = observation.target.getAttribute("data-story-entry-index");
            if (index && story.querySelector(`[data-story-media-index="${index}"]`))
              setActiveMedia(index);
          });
        },
        { threshold: 0.14 },
      );
      story.setAttribute("data-story-motion", "ready");
      if (stage) {
        story.setAttribute("data-story-stage-ready", "");
        stage.setAttribute("data-story-stage-ready", "");
      }
      entries.forEach((entry) => observer.observe(entry));
    });
  }
</script>
