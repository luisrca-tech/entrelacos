---
import type { HeroIntroContent, Media } from "../content";
import { buildIntroTimeline, introSourceForMedia } from "./homeIntro";

interface Props {
  content: HeroIntroContent;
  media: readonly Media[];
  heroMedia: Media;
}

const { content, media, heroMedia } = Astro.props;
const frames = [...media, heroMedia];
const timeline = buildIntroTimeline(frames.length);
---

<div
  class="group/intro hidden [[data-template-js=true]_&]:fixed [[data-template-js=true]_&]:inset-0 [[data-template-js=true]_&]:z-30 [[data-template-js=true]_&]:grid [[data-template-js=true]_&]:place-items-center [[data-template-js=true]_&]:overflow-hidden [[data-template-js=true]_&]:bg-template-ivory [[data-template-js=true]_&]:text-template-ink [[data-template-js=true]_&]:opacity-100 data-[template-intro-phase=fade]:opacity-0 data-[template-intro-phase=fade]:[transition:opacity_450ms_ease] data-[template-intro-phase=dismiss]:pointer-events-none data-[template-intro-phase=dismiss]:opacity-0 data-[template-intro-phase=dismiss]:[transition:opacity_450ms_ease] motion-reduce:hidden"
  data-template-home-intro
  data-split-at={timeline.splitAt}
  data-reveal-at={timeline.revealAt.join(",")}
  data-fullscreen-at={timeline.fullscreenAt}
  data-fade-at={timeline.fadeAt}
  data-complete-at={timeline.completeAt}
>
  <p
    class="absolute m-0 font-template-serif text-[clamp(2.25rem,5vw,calc(5rem*var(--template-width-scale)))] font-normal tracking-[-0.06em] leading-[0.88] [transition:opacity_500ms_ease,transform_700ms_cubic-bezier(0.22,1,0.36,1)] group-data-[template-intro-phase=split]/intro:[transform:scale(0.96)] group-data-[template-intro-phase=split]/intro:opacity-0 group-data-[template-intro-phase=dismiss]/intro:[transform:scale(0.96)] group-data-[template-intro-phase=dismiss]/intro:opacity-0 group-data-[template-intro-phase=fullscreen]/intro:[transform:scale(0.96)] group-data-[template-intro-phase=fullscreen]/intro:opacity-0 group-data-[template-intro-phase=fade]/intro:[transform:scale(0.96)] group-data-[template-intro-phase=fade]/intro:opacity-0 [@media(max-width:720px)]:text-[clamp(2rem,12vw,3.5rem)]"
    aria-hidden="true"
  >{content.brandLabel}</p>
  <div
    class="absolute inset-0 pointer-events-none opacity-0 [--template-intro-stage-height:0px] [--template-intro-label-gap:clamp(1rem,2.5vh,2rem)] group-data-[template-intro-phase=split]/intro:opacity-100 group-data-[template-intro-phase=dismiss]/intro:opacity-100 group-data-[template-intro-phase=fullscreen]/intro:opacity-100 group-data-[template-intro-phase=fade]/intro:opacity-100 group-data-[template-intro-phase=split]/intro:[--template-intro-stage-height:min(52svh,calc(19rem*var(--template-width-scale)))] group-data-[template-intro-phase=dismiss]/intro:[--template-intro-stage-height:min(52svh,calc(19rem*var(--template-width-scale)))] [@media(max-width:720px)]:group-data-[template-intro-phase=split]/intro:[--template-intro-stage-height:min(44svh,21rem)] [@media(max-width:720px)]:group-data-[template-intro-phase=dismiss]/intro:[--template-intro-stage-height:min(44svh,21rem)]"
    aria-hidden="true"
  >
    <p
      class="fixed left-1/2 top-1/2 z-[1] m-0 [transform:translate(-50%,-50%)] whitespace-nowrap font-template-serif text-[clamp(2.25rem,5vw,calc(5rem*var(--template-width-scale)))] font-normal tracking-[-0.06em] leading-[0.88] opacity-0 [transition:opacity_500ms_ease,transform_1.1s_cubic-bezier(0.22,1,0.36,1)] group-data-[template-intro-phase=split]/intro:opacity-100 group-data-[template-intro-phase=dismiss]/intro:opacity-100 group-data-[template-intro-phase=split]/intro:[transform:translate(-50%,calc(-100%_-_var(--template-intro-stage-height)_/_2_-_var(--template-intro-label-gap)))] group-data-[template-intro-phase=dismiss]/intro:[transform:translate(-50%,calc(-100%_-_var(--template-intro-stage-height)_/_2_-_var(--template-intro-label-gap)))] [@media(max-width:720px)]:text-[clamp(2rem,12vw,3.5rem)]"
    >
      {content.topLabel}
    </p>
    <div
      class="fixed left-1/2 top-1/2 z-0 h-[var(--template-intro-stage-height)] w-0 [transform:translate(-50%,-50%)] overflow-hidden bg-template-olive [transition:width_1.4s_cubic-bezier(0.22,1,0.36,1),height_1.4s_cubic-bezier(0.22,1,0.36,1)] group-data-[template-intro-phase=split]/intro:w-[min(84vw,calc(27.5rem*var(--template-width-scale)))] group-data-[template-intro-phase=dismiss]/intro:w-[min(84vw,calc(27.5rem*var(--template-width-scale)))] group-data-[template-intro-phase=fullscreen]/intro:z-[2] group-data-[template-intro-phase=fullscreen]/intro:h-svh group-data-[template-intro-phase=fullscreen]/intro:w-screen group-data-[template-intro-phase=fade]/intro:z-[2] group-data-[template-intro-phase=fade]/intro:h-svh group-data-[template-intro-phase=fade]/intro:w-screen [@media(max-width:720px)]:group-data-[template-intro-phase=split]/intro:w-[78vw] [@media(max-width:720px)]:group-data-[template-intro-phase=dismiss]/intro:w-[78vw]"
    >
      {frames.map((frame, index) => (
        <img
          class="absolute inset-0 z-[var(--template-intro-index)] block h-full w-full object-cover [clip-path:inset(100%_0_0)] [transition:clip-path_1.2s_cubic-bezier(0.22,1,0.36,1)] data-[template-intro-visible=true]:[clip-path:inset(0)]"
          src={introSourceForMedia(frame)}
          alt=""
          width={frame.width}
          height={frame.height}
          loading="eager"
          decoding="async"
          data-template-intro-frame={index}
          data-template-intro-visible={index === 0 ? "true" : undefined}
          style={`--template-intro-index: ${index};`}
        />
      ))}
    </div>
    <p
      class="fixed left-1/2 top-1/2 z-[1] m-0 [transform:translate(-50%,-50%)] whitespace-nowrap font-template-serif text-[clamp(2.25rem,5vw,calc(5rem*var(--template-width-scale)))] font-normal tracking-[-0.06em] leading-[0.88] opacity-0 [transition:opacity_500ms_ease,transform_1.1s_cubic-bezier(0.22,1,0.36,1)] group-data-[template-intro-phase=split]/intro:opacity-100 group-data-[template-intro-phase=dismiss]/intro:opacity-100 group-data-[template-intro-phase=split]/intro:[transform:translate(-50%,calc(var(--template-intro-stage-height)_/_2_+_var(--template-intro-label-gap)))] group-data-[template-intro-phase=dismiss]/intro:[transform:translate(-50%,calc(var(--template-intro-stage-height)_/_2_+_var(--template-intro-label-gap)))] group-data-[template-intro-phase=fullscreen]/intro:opacity-0 group-data-[template-intro-phase=fade]/intro:opacity-0 [@media(max-width:720px)]:text-[clamp(2rem,12vw,3.5rem)]"
    >
      {content.bottomLabel}
    </p>
  </div>
  <button
    class="absolute bottom-[max(1rem,env(safe-area-inset-bottom))] right-[max(1rem,env(safe-area-inset-right))] z-[3] min-h-11 cursor-pointer rounded-full border border-current bg-[color-mix(in_srgb,var(--template-ivory)_86%,transparent)] px-4 py-[0.65rem] font-sans text-template-ink hover:bg-template-ivory focus-visible:bg-template-ivory"
    type="button"
    data-template-intro-skip
  >
    Pular introdução
  </button>
</div>

<script>
  import { OVERLAY_FADE_MS, shouldExpandIntroIntoHero } from "./homeIntro";

  const reduceMotion = window.matchMedia?.(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  document.querySelectorAll<HTMLElement>("[data-template-home-intro]").forEach((intro) => {
    if (intro.dataset.templateIntroReady === "true") return;
    intro.dataset.templateIntroReady = "true";

    const hero = intro.parentElement?.querySelector<HTMLElement>(
      '[data-template-hero-intro][data-template-has-intro="true"]',
    );
    const header = document.querySelector<HTMLElement>("[data-template-navigation]");
    header?.setAttribute("data-template-intro-pending", "true");
    const frames = Array.from(
      intro.querySelectorAll<HTMLImageElement>("[data-template-intro-frame]"),
    );
    const skip = intro.querySelector<HTMLButtonElement>(
      "[data-template-intro-skip]",
    );
    const previousHtmlOverflow = document.documentElement.style.overflow;
    const previousBodyOverflow = document.body.style.overflow;
    const timers: number[] = [];
    const heroVideo = hero?.querySelector<HTMLVideoElement>(
      "[data-template-hero-video]",
    );
    let heroMediaPreparation: Promise<void> | undefined;
    let heroMediaStarted = false;
    let introCompleted = false;

    const prepareHeroMedia = () => {
      if (!(heroVideo instanceof HTMLVideoElement)) return Promise.resolve();
      if (heroMediaPreparation) return heroMediaPreparation;

      heroVideo.pause();
      heroVideo.preload = "auto";
      heroMediaPreparation = new Promise<void>((resolve) => {
        if (heroVideo.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
          resolve();
          return;
        }

        const finish = () => resolve();
        heroVideo.addEventListener("loadeddata", finish, { once: true });
        heroVideo.addEventListener("error", finish, { once: true });
        heroVideo.load();
      });

      return heroMediaPreparation;
    };

    const startHeroMedia = () => {
      if (!(hero instanceof HTMLElement) || heroMediaStarted) return;
      heroMediaStarted = true;
      hero.setAttribute("data-template-intro-media-ready", "true");
      hero
        .querySelector<HTMLElement>("[data-template-hero-media]")
        ?.setAttribute("data-template-intro-media-ready", "true");
      if (!(heroVideo instanceof HTMLVideoElement)) return;

      heroVideo.currentTime = 0;
      if (reduceMotion) {
        heroVideo.pause();
        return;
      }
      void heroVideo.play().catch(() => undefined);
    };

    const revealHeroChrome = () => {
      if (hero instanceof HTMLElement)
        hero.dataset.templateIntroComplete = "true";
      hero
        ?.querySelectorAll<HTMLElement>("[data-template-hero-media], [data-template-hero-copy]")
        .forEach((element) => element.setAttribute("data-template-intro-complete", "true"));
      if (header) header.dataset.templateIntroComplete = "true";
      header?.removeAttribute("data-template-intro-pending");
    };

    const complete = () => {
      if (introCompleted) return;
      introCompleted = true;
      timers.forEach((timer) => window.clearTimeout(timer));
      startHeroMedia();
      document.documentElement.style.overflow = previousHtmlOverflow;
      document.body.style.overflow = previousBodyOverflow;
      document.documentElement.dataset.templateIntroComplete = "true";
      intro.remove();

      if (reduceMotion) {
        revealHeroChrome();
        return;
      }

      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(revealHeroChrome);
      });
    };

    skip?.addEventListener("click", complete);

    if (reduceMotion || frames.length === 0) {
      complete();
      return;
    }

    document.documentElement.style.overflow = "hidden";
    document.body.style.overflow = "hidden";
    const heroMediaReady = prepareHeroMedia();

    const schedule = (callback: () => void, delay: number) => {
      timers.push(window.setTimeout(callback, delay));
    };
    const numberFromData = (value: string | undefined, fallback: number) => {
      const parsed = Number(value);
      return Number.isFinite(parsed) ? parsed : fallback;
    };
    const revealAt = (intro.dataset.revealAt ?? "")
      .split(",")
      .map(Number)
      .filter(Number.isFinite);
    const preload = Promise.all([
      heroMediaReady,
      ...frames.map(
        (frame) =>
          new Promise<void>((resolve) => {
            if (frame.complete) {
              resolve();
              return;
            }
            frame.addEventListener("load", () => resolve(), { once: true });
            frame.addEventListener("error", () => resolve(), { once: true });
          }),
      ),
    ]);
    const preloadTimeout = new Promise<void>((resolve) => {
      window.setTimeout(resolve, 4500);
    });

    void Promise.race([preload, preloadTimeout]).then(() => {
      const fullscreenAt = numberFromData(intro.dataset.fullscreenAt, 5000);
      const fadeAt = numberFromData(intro.dataset.fadeAt, 6200);
      const completeAt = numberFromData(intro.dataset.completeAt, 6650);
      const expandIntoHero = shouldExpandIntroIntoHero(
        hero?.getBoundingClientRect() ?? null,
        window.innerHeight,
      );
      intro.dataset.templateIntroPhase = "brand";
      schedule(
        () => { intro.dataset.templateIntroPhase = "split"; },
        numberFromData(intro.dataset.splitAt, 900),
      );
      revealAt.forEach((delay, index) => {
        schedule(() => {
          frames[index]?.setAttribute("data-template-intro-visible", "true");
        }, delay);
      });
      if (expandIntoHero) {
        schedule(
          () => { intro.dataset.templateIntroPhase = "fullscreen"; },
          fullscreenAt,
        );
        schedule(
          () => {
            startHeroMedia();
            intro.dataset.templateIntroPhase = "fade";
          },
          fadeAt,
        );
        schedule(complete, completeAt);
        return;
      }

      schedule(
        () => { intro.dataset.templateIntroPhase = "dismiss"; },
        fullscreenAt,
      );
      schedule(complete, fullscreenAt + OVERLAY_FADE_MS);
    });

    schedule(complete, numberFromData(intro.dataset.completeAt, 6650) + 5000);
  });
</script>
