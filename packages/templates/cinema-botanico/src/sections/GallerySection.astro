---
import { validateGalleryContent } from "../content";
import type { GalleryContent } from "../content";
import GalleryCarousel from "../components/GalleryCarousel";

interface Props {
  content: GalleryContent;
  tone?: "ivory" | "olive";
}

const { content, tone = "ivory" } = Astro.props;
validateGalleryContent(content);
const id = content.id;
const toneClasses = tone === "olive" ? "bg-template-olive text-template-ivory" : "bg-template-ivory text-template-ink";
const descriptionClass = tone === "olive" ? "text-[rgba(244,240,232,0.7)]" : "text-template-muted";
const revealClasses = "template-reveal";
---

<section
  id={id}
  class={`grid grid-cols-[minmax(16rem,0.58fr)_minmax(0,1.42fr)] gap-[clamp(2.5rem,6vw,7rem)] px-[var(--template-page-inset)] py-[clamp(5rem,10vw,9rem)] ${toneClasses} [@media(max-width:1024px)]:block [@media(max-width:1024px)]:px-0`}
  aria-labelledby={`${id}-title`}
>
  <header class={`${revealClasses} [@media(max-width:1024px)]:mb-12 [@media(max-width:1024px)]:px-[var(--template-page-inset)]`} data-template-reveal>
    {content.eyebrow && <p data-template-reveal-item data-template-reveal-kind="label" style="--template-reveal-delay: 0ms" class="m-0 mb-5 text-[0.72rem] font-bold uppercase tracking-[0.16em]">{content.eyebrow}</p>}
    <h2 data-template-reveal-item data-template-line-reveal class="m-0 max-w-[12ch] font-template-serif text-[clamp(2.5rem,6vw,calc(5.5rem*var(--template-width-scale)))] font-normal tracking-[-0.065em] leading-[0.96]" id={`${id}-title`}>{content.title}</h2>
    {content.description && <p data-template-reveal-item data-template-reveal-kind="body" style="--template-reveal-delay: 1400ms" class={`m-0 mt-7 max-w-[30rem] leading-[1.7] ${descriptionClass}`}>{content.description}</p>}
  </header>

  <div class="min-w-0 self-end" data-template-reveal="curtain">
    <div data-template-reveal-media>
      <GalleryCarousel content={content} client:load />
    </div>
  </div>
</section>
