---
import { validateStoryContent } from "../content";
import type { StoryContent } from "../content";
import { storyBackgroundFrames } from "./storyMediaCycle";

interface Props {
  content: StoryContent;
  tone?: "ivory" | "olive";
}

const { content, tone = "ivory" } = Astro.props;
validateStoryContent(content);
const id = content.id;
const frames = storyBackgroundFrames({
  media: content.media,
  sequence: content.sequence,
});
const primary = frames[0] ?? content.media;
const copyFrames = content.sequence?.some((frame) => frame.copy)
  ? [content, ...content.sequence.map((frame) => frame.copy ?? content)]
  : undefined;
const controls = copyFrames ? content.cycleControls : undefined;
const descriptionClass = "m-0 mt-6 max-w-[30rem] text-[rgba(244,240,232,0.78)] leading-[1.55] [@media(max-width:960px)]:max-w-112";
const bodyClass = "m-0 mt-4 max-w-160 text-[clamp(1rem,1.5vw,1.25rem)] leading-[1.6] text-[rgba(244,240,232,0.96)]";
const toneClasses = tone === "olive" ? "bg-template-olive text-template-ivory" : "bg-template-olive text-template-ivory";
---

<section
  id={id}
  class={`relative flex min-h-[calc(100svh-var(--template-header-height))] items-end overflow-hidden px-[var(--template-page-inset)] py-[clamp(3rem,5vw,5rem)] scroll-mt-[calc(var(--template-header-height,4.05rem)+1rem)] ${toneClasses} [@media(max-width:960px)]:flex-col [@media(max-width:960px)]:items-stretch [@media(max-width:960px)]:p-0 [@media(max-width:760px)]:mb-8`}
  data-template-story
  aria-labelledby={`${id}-title`}
  style={`--story-media-ratio: ${primary.width} / ${primary.height};`}
>
  <div data-template-reveal="curtain" class="absolute inset-0 z-0 [@media(max-width:960px)]:relative [@media(max-width:960px)]:inset-auto [@media(max-width:960px)]:min-h-[min(52svh,26rem)] [@media(max-width:960px)]:w-full [@media(max-width:960px)]:aspect-[var(--story-media-ratio,4/3)]">
  <figure data-template-reveal-media class="absolute inset-0 m-0 bg-template-olive">
    {content.media.kind === "image" ? (
      frames.map((frame, index) =>
        frame.kind === "image" ? (
          <img
            src={frame.src}
            alt={frame.alt}
            width={frame.width}
            height={frame.height}
            loading="lazy"
            decoding="async"
            data-story-frame
            data-story-active={index === 0 ? "true" : undefined}
            class="absolute inset-0 block h-full w-full object-cover object-[center_6%] opacity-0 transition-opacity duration-[1800ms] ease-in-out data-[story-outgoing=true]:opacity-100 data-[story-active=true]:z-[1] data-[story-active=true]:opacity-100 motion-reduce:scale-100 motion-reduce:!animate-none motion-reduce:transition-none data-[story-active=true]:motion-reduce:opacity-100"
            aria-hidden={index === 0 ? undefined : "true"}
          />
        ) : null,
      )
    ) : (
        <video
        class="absolute inset-0 block h-full w-full object-cover object-[center_6%] opacity-100 transition-opacity duration-[1800ms] ease-in-out motion-reduce:scale-100 motion-reduce:!animate-none motion-reduce:transition-none"
        src={content.media.src}
        poster={content.media.poster}
        width={content.media.width}
        height={content.media.height}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label={content.media.alt}
      >
        <img
          src={content.media.poster}
          alt={content.media.alt}
          width={content.media.width}
          height={content.media.height}
          loading="lazy"
        />
      </video>
    )}
  </figure>
  </div>
  <div class="absolute inset-0 z-[1] [background:var(--template-story-gradient)]" aria-hidden="true"></div>
  <div
    class="relative z-[2] max-w-[min(42rem,100%)] [@media(max-width:960px)]:grow [@media(max-width:960px)]:max-w-none [@media(max-width:960px)]:bg-template-olive [@media(max-width:960px)]:px-4 [@media(max-width:960px)]:pb-10 [@media(max-width:960px)]:pt-8"
    data-story-copy
    data-template-reveal
  >
    {content.eyebrow && <p data-template-reveal-item data-template-reveal-kind="label" class="m-0 mb-5 text-[0.72rem] font-bold uppercase tracking-[0.16em]">{content.eyebrow}</p>}
    <h2 data-template-reveal-item data-template-line-reveal class="m-0 max-w-[18ch] font-template-serif text-[clamp(2.5rem,5.5vw,calc(5.6rem*var(--template-width-scale)))] font-normal tracking-[-0.065em] leading-[0.94] [@media(max-width:960px)]:max-w-[12ch] [@media(max-width:960px)]:text-[clamp(2.5rem,12vw,4.5rem)]" id={`${id}-title`}>{content.title}</h2>
    {copyFrames ? (
      <div class="grid">
        {copyFrames.map((copy, index) => (
          <div class="col-start-1 row-start-1" data-story-copy-frame data-story-active={index === 0 ? "true" : undefined} aria-hidden={index !== 0}>
            {copy.description && <p data-template-reveal-item data-template-reveal-kind="body" class={descriptionClass}>{copy.description}</p>}
            <p data-template-reveal-item data-template-reveal-kind="body" class={bodyClass}>{copy.body}</p>
          </div>
        ))}
      </div>
    ) : (
      <>
        {content.description && <p data-template-reveal-item data-template-reveal-kind="body" class={descriptionClass}>{content.description}</p>}
        <p data-template-reveal-item data-template-reveal-kind="body" class={bodyClass}>{content.body}</p>
      </>
    )}
    {controls && <button type="button" hidden data-story-toggle data-pause-label={controls.pauseLabel} data-resume-label={controls.resumeLabel} data-template-reveal-item class="mt-2 min-h-11 cursor-pointer border-0 bg-transparent p-0 text-sm text-inherit underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4">{controls.pauseLabel}</button>}
  </div>
</section>

<script>
  import { setupStoryMediaCycle } from "./storyMediaCycle";

  const reducedMotion = window.matchMedia?.(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  document.querySelectorAll<HTMLElement>("[data-template-story]").forEach((story) => {
    if (story.dataset.storyCycle === "ready") return;
    story.dataset.storyCycle = "ready";

    setupStoryMediaCycle(story, {
      reducedMotion,
      Observer: window.IntersectionObserver,
    });
  });
</script>

<style>
  [data-story-copy-frame] {
    min-width: 0;
    opacity: 0;
    visibility: hidden;
  }

  [data-story-copy-frame][data-story-active="true"] {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-story-copy-frame] {
      translate: 0 0.35rem;
      transition: opacity 320ms ease, translate 320ms ease, visibility 0s 320ms;
    }

    [data-story-copy-frame][data-story-active="true"] {
      translate: 0 0;
      transition: opacity 700ms ease 360ms, translate 700ms ease 360ms, visibility 0s;
    }
  }
</style>
