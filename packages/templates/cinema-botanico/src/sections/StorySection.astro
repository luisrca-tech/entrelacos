---
import { validateStoryContent } from "../content";
import type { StoryContent } from "../content";
import { buildStoryChapters } from "./storyChapters";

interface Props {
  content: StoryContent;
  tone?: "ivory" | "olive";
}

const { content } = Astro.props;
validateStoryContent(content);
const id = content.id;
const chapters = buildStoryChapters(content);
const hasChapters = chapters.length > 1;
---

<section
  id={id}
  class="story-section grid grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] items-center gap-[clamp(3rem,6vw,7rem)] overflow-hidden bg-template-olive px-[var(--template-page-inset)] py-[clamp(5rem,7vw,8rem)] text-template-ivory scroll-mt-[var(--template-header-height)] [@media(max-width:960px)]:grid-cols-1 [@media(max-width:960px)]:gap-0 [@media(max-width:960px)]:p-0 [@media(max-width:760px)]:mb-8"
  data-template-story
  data-story-timed={hasChapters ? "true" : undefined}
  aria-labelledby={`${id}-title`}
  style={`--story-media-ratio: ${content.media.width} / ${content.media.height};`}
>
  <div data-template-reveal="curtain" class="relative min-w-0 w-full aspect-[4/5] max-h-[min(50rem,85svh)] [@media(max-width:960px)]:aspect-[var(--story-media-ratio,4/3)] [@media(max-width:960px)]:max-h-[min(52svh,32rem)]">
    <figure data-template-reveal-media class="absolute inset-0 m-0 overflow-hidden rounded-[0.75rem] bg-template-ink">
      {content.media.kind === "image" ? chapters.map((chapter, index) => (
        <img
          src={chapter.media.src}
          alt={chapter.media.alt}
          width={chapter.media.width}
          height={chapter.media.height}
          loading="lazy"
          decoding="async"
          data-story-frame
          data-story-active={index === 0 ? "true" : undefined}
          aria-hidden={index !== 0}
          class="absolute inset-0 block h-full w-full object-cover object-[center_35%] opacity-0 transition-opacity duration-700 ease-in-out data-[story-active=true]:z-[1] data-[story-active=true]:opacity-100 motion-reduce:transition-none"
        />
      )) : (
        <video
          class="absolute inset-0 block h-full w-full object-cover"
          src={content.media.src}
          poster={content.media.poster}
          width={content.media.width}
          height={content.media.height}
          autoplay muted loop playsinline preload="metadata"
          aria-label={content.media.alt}
        >
          <img src={content.media.poster} alt={content.media.alt} width={content.media.width} height={content.media.height} loading="lazy" />
        </video>
      )}
    </figure>
  </div>

  <div class="min-w-0 [@media(max-width:960px)]:px-[var(--template-page-inset)] [@media(max-width:960px)]:pt-9 [@media(max-width:960px)]:pb-12" data-story-copy data-template-reveal>
    {content.eyebrow && <p data-template-reveal-item data-template-reveal-kind="label" class="m-0 mb-6 text-[0.72rem] font-bold uppercase tracking-[0.18em] text-template-ivory/70">{content.eyebrow}</p>}
    <h2 data-template-reveal-item data-template-line-reveal class="m-0 font-template-serif text-[clamp(3.5rem,5.5vw,6.5rem)] font-normal tracking-[-0.065em] leading-[0.98] [@media(max-width:960px)]:max-w-[14ch] [@media(max-width:960px)]:text-[clamp(2.5rem,10vw,4.5rem)]" id={`${id}-title`}>{content.title}</h2>

    <div data-story-reading class="story-copy-frames mt-10 border-t border-template-ivory/25 pt-7 [@media(max-width:960px)]:mt-7" data-template-reveal-item data-template-reveal-kind="body">
      {chapters.map((chapter, index) => (
        <div data-story-copy-frame data-story-active={index === 0 ? "true" : undefined} id={hasChapters ? `${id}-chapter-${index + 1}` : undefined} class="min-w-0">
          {hasChapters && <h3 class="m-0 mb-5 font-template-serif text-[clamp(1.5rem,2vw,2rem)] font-normal [[data-story-ready=true]_&]:sr-only">{chapter.label}</h3>}
          {chapter.description && <p class="m-0 mb-4 [@media(max-width:960px)]:max-w-[38ch] text-base leading-[1.7] text-template-ivory/70">{chapter.description}</p>}
          <p class="m-0 [@media(max-width:960px)]:max-w-[38ch] text-[clamp(1rem,1.3vw,1.2rem)] leading-[1.8] text-template-ivory/90">{chapter.body}</p>
        </div>
      ))}
    </div>

    {hasChapters && <div data-story-tabs hidden role="group" aria-label={content.eyebrow ?? content.title} class="mt-10 grid grid-cols-[repeat(auto-fit,minmax(6rem,1fr))] gap-x-4 gap-y-3 [@media(max-width:960px)]:mt-8">
      {chapters.map((chapter, index) => (
        <button
          type="button"
          data-story-chapter
          aria-controls={`${id}-chapter-${index + 1}`}
          aria-pressed={index === 0}
          class="group/chapter relative min-h-16 cursor-pointer border-0 border-t border-solid border-template-ivory/25 bg-transparent px-0 pb-1 pt-4 text-left font-[inherit] text-template-ivory/70 transition-[color,border-color] duration-300 hover:text-template-ivory aria-pressed:text-template-ivory focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-template-ivory motion-reduce:transition-none"
        >
          <span data-story-progress aria-hidden="true" class="absolute -top-px inset-x-0 h-px origin-left bg-template-ivory"></span>

          <span data-story-label class="block text-[0.8rem] leading-snug">{chapter.label}</span>
        </button>
      ))}
    </div>}
  </div>
</section>

<script>
  import { setupStoryChapters } from "./storyChapters";

  document.querySelectorAll<HTMLElement>("[data-template-story]").forEach((story) => {
    if (story.dataset.storyReady === "true") return;
    setupStoryChapters(story);
  });
</script>

<style>
  [data-story-tabs][hidden] { display: none; }
  [data-story-chapter][aria-pressed="true"] [data-story-label] { text-decoration: underline; text-underline-offset: 0.3em; }
  [data-story-progress] { transform: scaleX(0); }
  [data-story-chapter][aria-pressed="true"] [data-story-progress] { transform: scaleX(var(--story-progress, 1)); }
  [data-story-autoplay="false"] [data-story-chapter][aria-pressed="true"] [data-story-progress] { transform: scaleX(1); }
  .story-copy-frames { display: grid; gap: 2rem; }
  [data-story-ready="true"] .story-copy-frames { gap: 0; }
  [data-story-ready="true"] [data-story-copy-frame] {
    grid-area: 1 / 1;
    margin-top: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 250ms ease, visibility 0s 250ms;
  }
  [data-story-ready="true"] [data-story-copy-frame][data-story-active="true"] {
    opacity: 1;
    visibility: visible;
    transition: opacity 400ms ease 100ms, visibility 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-story-ready="true"] [data-story-copy-frame] { transition: none; }
  }
</style>
