---
import LetterHandoff from "./LetterHandoff.astro";
import { type LetterContent, validateLetterContent } from "../letterContent";

interface Props { content: LetterContent; }
const { content } = Astro.props;
validateLetterContent(content);
const [coverPhoto, storyPhoto, insertPhoto] = content.photos;
const paragraphDelay = (index: number) => `${650 + index * 170}ms`;
const folioClass = "m-0 mb-8 text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-template-muted";
---

<section class="grid grid-cols-[var(--template-letter-columns)] items-center gap-x-[var(--template-letter-gap)] gap-y-12 px-[var(--template-page-inset)] pt-[clamp(3rem,7vw,7rem)] [@media(max-width:760px)]:grid-cols-1 [@media(max-width:760px)]:gap-y-8 [@media(max-width:760px)]:pt-8" id={content.cover.id} aria-labelledby={`${content.cover.id}-title`}>
  <div class="min-w-0">
    {content.cover.eyebrow && <p class={`${folioClass} [@media(max-width:760px)]:mb-4`}>{content.cover.eyebrow}</p>}
    <span class="mb-7 flex size-16 items-center justify-center whitespace-nowrap rounded-full border border-template-olive font-template-serif text-xl italic leading-none text-template-olive [@media(max-width:760px)]:mb-4 [@media(max-width:760px)]:size-10 [@media(max-width:760px)]:text-xs" aria-hidden="true">{content.monogram}</span>
    <h1 class="m-0 max-w-[9ch] font-template-serif text-[clamp(3rem,7.5vw,calc(7.5rem*var(--template-width-scale)))] font-normal leading-[0.98] tracking-[-0.065em] text-template-olive motion-safe:[animation:template-letter-name_750ms_cubic-bezier(0.22,1,0.36,1)_both] [@media(max-width:760px)]:max-w-none [@media(max-width:760px)]:text-[clamp(3rem,13vw,5rem)]" id={`${content.cover.id}-title`}>{content.cover.title}</h1>
    <p class="mb-4 mt-7 text-base leading-[1.75] [@media(max-width:760px)]:mt-4">{content.dateLabel}<br />{content.locationLabel}</p>
    {content.cover.description && <p class="mb-6 mt-4 max-w-[31ch] leading-[1.65] text-template-muted [@media(max-width:760px)]:hidden">{content.cover.description}</p>}
    <a class="inline-flex min-h-12 items-center justify-between gap-10 bg-template-olive px-6 py-3 text-template-ivory no-underline" href={content.action.href}>{content.action.label}<span aria-hidden="true">↗</span></a>
  </div>
  <figure class="m-0 mb-3 rotate-2 border border-template-line bg-[var(--template-paper)] p-[clamp(0.6rem,1.5vw,1.25rem)] shadow-[0_1rem_3rem_#30212a15] [@media(max-width:760px)]:mt-4 [@media(max-width:760px)]:w-[min(76%,22rem)] [@media(max-width:760px)]:justify-self-center">
    <div class="relative overflow-hidden" data-photo-curtain><img class="block aspect-[4/5] [@media(min-width:1280px)]:aspect-[5/4] h-auto w-full object-cover object-center" src={coverPhoto.src} alt={coverPhoto.alt} width={coverPhoto.width} height={coverPhoto.height} fetchpriority="high" /><span data-curtain-layer aria-hidden="true"></span></div>
  </figure>
  {content.coverHandoff && <LetterHandoff ruled>{content.coverHandoff}</LetterHandoff>}
</section>

<section class="grid grid-cols-[var(--template-letter-columns)] items-start gap-x-[var(--template-letter-gap)] gap-y-12 px-[var(--template-page-inset)] pt-[clamp(3rem,7vw,7rem)] [@media(max-width:760px)]:grid-cols-1 [@media(max-width:760px)]:gap-y-8" id={content.story.id} aria-labelledby={`${content.story.id}-title`}>
  <div class="letter-story-copy min-w-0 border border-template-line bg-[var(--template-paper)] p-[clamp(1.5rem,3vw,3rem)] shadow-[0_0.5rem_2rem_#30212a06]" data-template-reveal>
    {content.story.eyebrow && <p class={folioClass} data-template-reveal-item>{content.story.eyebrow}</p>}
    <h2 class="m-0 mb-7 font-template-letter text-[clamp(2rem,3vw,2.75rem)] font-medium leading-[1.2] text-template-olive" id={`${content.story.id}-title`} data-template-reveal-item>{content.story.title}</h2>
    <div class="max-w-[48ch] font-template-letter text-[clamp(1.5rem,1.8vw,1.8rem)] font-medium leading-[1.45] [&_p]:m-0 [&_p]:mb-6">
      {content.story.paragraphs.map((paragraph, index) => (
        <p data-template-reveal-item data-letter-paragraph style={`--letter-paragraph-delay: ${paragraphDelay(index)}`}>{paragraph}</p>
      ))}
    </div>
    <p data-template-reveal-item data-letter-paragraph style={`--letter-paragraph-delay: ${paragraphDelay(content.story.paragraphs.length)}`} class="mb-0 mt-8 font-template-letter text-[clamp(1.75rem,2.4vw,2.25rem)] font-medium leading-[1.3] text-template-olive">{content.signature}</p>
  </div>
  <div class="relative min-w-0 self-center [@media(max-width:760px)]:max-w-[28rem] [@media(max-width:760px)]:pt-0">
    <figure class="m-0 border border-template-line bg-[var(--template-paper)] p-2.5">
      <div class="relative overflow-hidden" data-photo-curtain><img class="block aspect-[4/5] [@media(min-width:1280px)]:aspect-[5/4] h-auto w-full object-cover [@media(max-width:760px)]:aspect-[4/3]" src={storyPhoto.src} alt={storyPhoto.alt} width={storyPhoto.width} height={storyPhoto.height} loading="lazy" /><span data-curtain-layer aria-hidden="true"></span></div>
    </figure>
    {insertPhoto && <figure class="relative m-0 -ml-4 -mt-12 w-[55%] -rotate-3 border border-template-line bg-[var(--template-paper)] p-2"><div class="relative overflow-hidden" data-photo-curtain><img class="block h-auto w-full" src={insertPhoto.src} alt={insertPhoto.alt} width={insertPhoto.width} height={insertPhoto.height} loading="lazy" /><span data-curtain-layer aria-hidden="true"></span></div></figure>}
  </div>
  {content.storyHandoff && <LetterHandoff ruled>{content.storyHandoff}</LetterHandoff>}
</section>

<script>
  import { mountPhotoCurtains } from "../components/photoCurtains";
  mountPhotoCurtains(document, window, window.matchMedia("(prefers-reduced-motion: reduce)"));
</script>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .letter-story-copy[data-template-motion-ready="true"][data-template-reveal-state="hidden"] [data-template-reveal-item] {
      transition: none;
    }

    .letter-story-copy[data-template-motion-ready="true"][data-template-reveal-state="visible"] [data-letter-paragraph] {
      transition-delay: var(--letter-paragraph-delay);
    }

    :global(html[data-photo-curtains]) [data-curtain-layer] {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: var(--template-paper);
    }
  }
</style>
