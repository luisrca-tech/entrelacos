---
import { type LetterContent, validateLetterContent } from "../letterContent";

interface Props { content: LetterContent; }
const { content } = Astro.props;
validateLetterContent(content);
const [coverPhoto, storyPhoto, insertPhoto] = content.photos;
const handoffClass = "col-span-full m-0 flex items-center gap-6 border-b border-template-line py-8 font-template-serif text-[clamp(1rem,1.5vw,1.25rem)] italic leading-[1.65] text-template-muted before:h-px before:w-[clamp(1.5rem,6vw,6rem)] before:shrink-0 before:bg-current before:opacity-50 before:content-['']";
const folioClass = "m-0 mb-8 text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-template-muted";
---

<section class="mx-auto grid max-w-[94rem] grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] items-center gap-x-[clamp(2rem,7vw,7rem)] gap-y-12 px-[clamp(1.25rem,5vw,5rem)] pt-[clamp(3rem,7vw,7rem)] [@media(max-width:760px)]:grid-cols-1 [@media(max-width:760px)]:gap-y-8 [@media(max-width:760px)]:pt-8" id={content.cover.id} aria-labelledby={`${content.cover.id}-title`}>
  <div class="min-w-0">
    {content.cover.eyebrow && <p class={`${folioClass} [@media(max-width:760px)]:mb-4`}>{content.cover.eyebrow}</p>}
    <span class="mb-7 grid size-16 place-items-center rounded-full border border-template-olive font-template-serif text-xl italic text-template-olive [@media(max-width:760px)]:mb-4 [@media(max-width:760px)]:size-10 [@media(max-width:760px)]:text-sm" aria-hidden="true">{content.monogram}</span>
    <h1 class="m-0 max-w-[9ch] font-template-serif text-[clamp(3rem,7.5vw,7.5rem)] font-normal leading-[0.98] tracking-[-0.065em] text-template-olive motion-safe:[animation:template-letter-name_750ms_cubic-bezier(0.22,1,0.36,1)_both] [@media(max-width:760px)]:max-w-none [@media(max-width:760px)]:text-[clamp(3rem,13vw,5rem)]" id={`${content.cover.id}-title`}>{content.cover.title}</h1>
    <p class="mb-4 mt-7 text-base leading-[1.75] [@media(max-width:760px)]:mt-4">{content.dateLabel}<br />{content.locationLabel}</p>
    {content.cover.description && <p class="mb-6 mt-4 max-w-[31ch] leading-[1.65] text-template-muted [@media(max-width:760px)]:hidden">{content.cover.description}</p>}
    <a class="inline-flex min-h-12 items-center justify-between gap-10 bg-template-olive px-6 py-3 text-template-ivory no-underline" href={content.action.href}>{content.action.label}<span aria-hidden="true">↗</span></a>
  </div>
  <figure class="m-0 mb-3 rotate-2 border border-template-line bg-[var(--template-paper)] p-[clamp(0.6rem,1.5vw,1.25rem)] shadow-[0_1rem_3rem_#30212a15] [@media(max-width:760px)]:mt-4 [@media(max-width:760px)]:w-[min(76%,22rem)] [@media(max-width:760px)]:justify-self-center">
    <div class="relative overflow-hidden" data-photo-curtain><img class="block aspect-[4/5] h-auto w-full object-cover object-center" src={coverPhoto.src} alt={coverPhoto.alt} width={coverPhoto.width} height={coverPhoto.height} fetchpriority="high" /></div>
    <figcaption class="pb-1 pt-5 text-center font-template-serif text-[clamp(0.9rem,1.3vw,1.15rem)] italic leading-normal">{content.signature}</figcaption>
  </figure>
  <p class={handoffClass}>{content.coverHandoff}</p>
</section>

<section class="mx-auto grid max-w-[94rem] grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] items-start gap-x-[clamp(2rem,7vw,7rem)] gap-y-12 px-[clamp(1.25rem,5vw,5rem)] pt-[clamp(3rem,7vw,7rem)] [@media(max-width:760px)]:grid-cols-1 [@media(max-width:760px)]:gap-y-8" id={content.story.id} aria-labelledby={`${content.story.id}-title`}>
  <div data-template-reveal>
    {content.story.eyebrow && <p class={folioClass} data-template-reveal-item>{content.story.eyebrow}</p>}
    <h2 class="m-0 mb-8 max-w-[13ch] font-template-serif text-[clamp(2.5rem,4.5vw,4.7rem)] font-normal leading-[1.07] tracking-[-0.045em]" id={`${content.story.id}-title`} data-template-reveal-item>{content.story.title}</h2>
    <div class="max-w-[55ch] text-[clamp(1rem,1.4vw,1.125rem)] leading-[1.75] [&_p]:m-0 [&_p]:mb-5">
      {content.story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <p class="mt-8 font-template-serif text-[1.4rem] italic leading-[1.65] text-template-olive">{content.signature}</p>
  </div>
  <div class="relative min-w-0 pt-16 [@media(max-width:760px)]:max-w-[28rem] [@media(max-width:760px)]:pt-0">
    <figure class="m-0 border border-template-line bg-[var(--template-paper)] p-2.5">
      <div class="relative overflow-hidden" data-photo-curtain><img class="block aspect-[4/5] h-auto w-full object-cover [@media(max-width:760px)]:aspect-[4/3]" src={storyPhoto.src} alt={storyPhoto.alt} width={storyPhoto.width} height={storyPhoto.height} loading="lazy" /></div>
    </figure>
    {insertPhoto && <figure class="relative m-0 -ml-4 -mt-12 w-[55%] -rotate-3 border border-template-line bg-[var(--template-paper)] p-2"><div class="relative overflow-hidden" data-photo-curtain><img class="block h-auto w-full" src={insertPhoto.src} alt={insertPhoto.alt} width={insertPhoto.width} height={insertPhoto.height} loading="lazy" /></div></figure>}
    <p class="text-right font-template-serif text-base italic leading-[1.8] text-template-muted" aria-hidden="true">{content.monogram}<br />—<br />{content.dateLabel}</p>
  </div>
  <p class={handoffClass}>{content.storyHandoff}</p>
</section>

<script>
  import { mountPhotoCurtains } from "../components/photoCurtains";
  mountPhotoCurtains(document, window, window.matchMedia("(prefers-reduced-motion: reduce)"));
</script>
