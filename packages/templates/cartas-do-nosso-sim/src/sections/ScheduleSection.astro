---
import GuidanceDetail from "../components/GuidanceDetail";
import { validateScheduleContent } from "../content";
import type { ScheduleContent } from "../content";

interface Props {
  content: ScheduleContent;
  tone?: "ivory" | "olive";
}

const { content, tone = "olive" } = Astro.props;
validateScheduleContent(content);
const id = content.id;
const toneClasses = tone === "olive" ? "bg-template-olive text-template-ivory" : "bg-template-ivory text-template-ink";
const descriptionClass = tone === "olive" ? "text-[rgba(244,240,232,0.7)]" : "text-template-muted";
const revealClasses = "template-reveal";
const dividerClass = tone === "olive" ? "bg-[rgba(244,240,232,0.24)]" : "bg-template-line";
---

<section
  id={id}
  class={`grid grid-cols-[var(--template-letter-columns)] gap-[var(--template-letter-gap)] px-[var(--template-page-inset)] py-[clamp(5rem,10vw,9rem)] ${toneClasses} [@media(max-width:960px)]:block`}
  aria-labelledby={`${id}-title`}
>
  <header class={`${revealClasses} [@media(max-width:960px)]:mb-12`} data-template-reveal>
    {content.eyebrow && <p data-template-reveal-item data-template-reveal-kind="label" style="--template-reveal-delay: 0ms" class="m-0 mb-5 text-[0.72rem] font-bold uppercase tracking-[0.16em]">{content.eyebrow}</p>}
    <h2 data-template-reveal-item data-template-line-reveal class="m-0 max-w-[12ch] font-template-serif text-[clamp(2.5rem,6vw,calc(5.5rem*var(--template-width-scale)))] font-normal tracking-[-0.065em] leading-[0.96]" id={`${id}-title`}>{content.title}</h2>
    {content.description && <p data-template-reveal-item data-template-reveal-kind="body" style="--template-reveal-delay: 1400ms" class={`m-0 mt-7 max-w-[30rem] leading-[1.7] ${descriptionClass}`}>{content.description}</p>}
  </header>
  <div class={`${revealClasses} min-w-0 self-end`}>
    <ol class="m-0 list-none p-0" aria-label={content.title}>
      {content.entries.map((entry) => (
        <li data-template-reveal id={entry.id} class="group relative grid grid-cols-[minmax(4rem,0.28fr)_minmax(0,1fr)] gap-4 py-6 first:pt-0">
          <span data-template-reveal-item data-template-reveal-kind="card" class={`pointer-events-none absolute inset-x-0 top-0 h-px group-first:hidden ${dividerClass}`} aria-hidden="true"></span>
          <time data-template-reveal-item data-template-reveal-kind="label" class="text-[0.9rem] uppercase tracking-[0.08em]">{entry.time}</time>
          <div data-template-reveal-item data-template-reveal-kind="card">
            <h3 class="m-0 text-[clamp(1.4rem,2.5vw,2rem)] font-medium tracking-[-0.025em] leading-[1.1]">{entry.title}</h3>
            <p class="m-0 mt-3 max-w-[30rem] leading-[1.6]">{entry.body}</p>
            {entry.location && <p class={`m-0 mt-3 max-w-[30rem] text-[0.9rem] leading-[1.6] ${descriptionClass}`}>{entry.location}</p>}
          </div>
        </li>
      ))}
    </ol>
    {content.guidance && content.guidance.length > 0 && (
      <aside data-template-reveal class="relative mt-12 pt-8" aria-labelledby={`${id}-guidance-title`}>
        <span data-template-reveal-item class={`pointer-events-none absolute inset-x-0 top-0 h-px ${dividerClass}`} aria-hidden="true"></span>
        <h3 data-template-reveal-item class="m-0 mb-7 text-[clamp(1.4rem,2.5vw,2rem)] font-medium tracking-[-0.025em] leading-[1.1]" id={`${id}-guidance-title`}>{content.guidanceLabel}</h3>
        <ul data-template-reveal-item style="--template-reveal-delay: 550ms" class="m-0 list-none p-0">
          {content.guidance.map((item) => (
            <li class="[&+li]:mt-6" id={item.id}>
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                <strong>{item.title}</strong>
                {item.detail && <GuidanceDetail detail={item.detail} titleId={`${item.id}-detail-title`} client:load />}
              </div>
              <p class="m-0 mt-3 max-w-[36rem] leading-[1.6]">{item.body}</p>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</section>
